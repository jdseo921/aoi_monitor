<UserControl x:Class="AOI_Monitor.Views.SpcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AOI_Monitor.Controls"
             Background="{DynamicResource HmiBgBrush}">
  <UserControl.Resources>
    <Style x:Key="DbStatusChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="NG">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="WARN">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="OK">
          <Setter Property="Background" Value="#14311D"/>
          <Setter Property="BorderBrush" Value="#377849"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DbStatusChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="NG">
          <Setter Property="Foreground" Value="{DynamicResource HmiNgSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="WARN">
          <Setter Property="Foreground" Value="{DynamicResource HmiWarnSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="OK">
          <Setter Property="Foreground" Value="{DynamicResource HmiOkSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource FactoryScrollablePage}">
  <!-- Fill the viewport: the chart and DB-health table absorb spare height (audit
       TrailingVoidPercent was 59.2% at 1080p before this). -->
  <Grid Margin="8" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="410"/>
      </Grid.ColumnDefinitions>

      <!-- SPC Chart + stats -->
      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
                <TextBlock Text="Demo Trend / Not Live Data" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
              </Border>
              <TextBlock Text="SPC / SQLite Summary" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <c:LineChart/>
            <WrapPanel Grid.Row="1" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="10" Height="3" Fill="#5CA0D3" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="Yield" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="10" Height="3" Fill="#E1A334" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="False Calls" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel>
              <StackPanel Orientation="Horizontal"><Rectangle Width="10" Height="3" Fill="#F13B3F" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="Escapes" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel>
            </WrapPanel>
            <!-- Stats grid. SQLite Inspections / Review Events / Imported Images duplicated
                 Database Health table rows on the same screen and were removed; the
                 Database Health table remains the authoritative per-table view. -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0" Rows="1">
              <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="OK / NG / REVIEW" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock x:Name="VerdictBreakdownText" Text="0 / 0 / 0" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="SQLite Yield" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock x:Name="YieldText" Text="--" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Broken Vault Links" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock x:Name="BrokenImageLinksText" Text="0" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
            </UniformGrid>
          </Grid>
        </Grid>
      </Border>

      <!-- DB health -->
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Database Health" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="DbHealthGrid" Style="{StaticResource HmiTable}" MinWidth="340">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Table / Index" Binding="{Binding Table}"  Width="*" MinWidth="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding Table}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Count"         Binding="{Binding Count}"  Width="90" MinWidth="90"/>
              <DataGridTemplateColumn Header="Status" Width="96" MinWidth="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource DbStatusChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                      <TextBlock Text="{Binding Status}" Style="{StaticResource DbStatusChipText}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom alarm -->
    <Border Grid.Row="1" Background="#14080A" BorderBrush="#4B2325" BorderThickness="1" Padding="7,10">
      <TextBlock x:Name="DatabaseWarningText" Text="SQLite summary loaded from local PoC database."
                 Foreground="{DynamicResource HmiNgBrush}" FontWeight="ExtraBold" TextAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>

