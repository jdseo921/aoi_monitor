<UserControl x:Class="AOI_Monitor.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <ScrollViewer Style="{StaticResource FactoryViewportFillPage}">
    <!-- Viewport-fill idiom: the page inset lives on the ScrollViewer Padding; the root
         Grid carries NO outer Margin so the star rows genuinely bound the points table
         and the click-to-set-point preview instead of leaving a permanent scroll sliver. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="2D Calibration Profile / Stage 2 Preparation" Style="{StaticResource HmiPageTitleText}"/>
            <TextBlock Text="Define image-to-board point pairs for planning camera/robot coordinate mapping."
                       Style="{StaticResource HmiPageSubtitleText}" Margin="0,3,0,0"/>
            <Border Style="{StaticResource HmiEvidenceBoundaryOnly}" Margin="0,8,12,0" MaxWidth="720">
              <TextBlock Text="Stage 2 preparation only - not live camera/robot calibration"
                         Foreground="{DynamicResource HmiWarnSoftBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         FontWeight="ExtraBold"
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HmiRightActionBand}">
            <Button Style="{StaticResource ActionBtnBlue}" Content="Reload Profiles" Margin="{StaticResource HmiButtonGap}" Click="OnReloadProfilesClick"/>
            <Button Style="{StaticResource ActionBtnGreen}" Content="Save Profile" Margin="{StaticResource HmiButtonGap}" Click="OnSaveProfileClick"/>
          </WrapPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <!-- MinHeight keeps the click-to-set-point surface usable even when the
                   form above grows (long paths, wrapped labels). -->
              <RowDefinition Height="*" MinHeight="220"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
              <TextBlock Text="Calibration Profile" Style="{StaticResource HmiSectionHeaderText}"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="10" Grid.IsSharedSizeScope="True">
              <Grid Margin="{StaticResource HmiRowGap}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CalibrationFormLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Saved Profile" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileCombo" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Saved calibration profile" DisplayMemberPath="DisplayName" SelectionChanged="OnProfileSelectionChanged" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectionBoxItem}"/>
              </Grid>
              <Grid Margin="{StaticResource HmiRowGap}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CalibrationFormLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Profile Name" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ProfileNameText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Profile name"/>
              </Grid>
              <Grid Margin="{StaticResource HmiRowGap}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CalibrationFormLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Board Model" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="BoardModelText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Board model"/>
              </Grid>
              <Grid Margin="{StaticResource HmiRowGap}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CalibrationFormLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="View" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ViewTypeCombo" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Calibration view" SelectedIndex="0">
                  <ComboBoxItem Content="Top" Tag="Top"/>
                  <ComboBoxItem Content="Side" Tag="Side"/>
                  <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                </ComboBox>
              </Grid>
              <Grid Margin="{StaticResource HmiRowGap}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CalibrationFormLabel"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sample Image" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SampleImagePathText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Sample image path" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                <Button Style="{StaticResource MiniBtn}" Grid.Column="2" Content="Browse" Margin="8,0,0,0" Click="OnBrowseSampleImageClick"/>
              </Grid>

              <Border Style="{StaticResource FieldBox}" Margin="0,6,0,0">
                <StackPanel>
                  <TextBlock Text="Add Calibration Point" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,8"/>
                  <UniformGrid Columns="4" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Image X (px)" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="ImageXText" MinHeight="34" AutomationProperties.Name="New point image X pixels"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Image Y (px)" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="ImageYText" MinHeight="34" AutomationProperties.Name="New point image Y pixels"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Board X (mm)" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="BoardXText" MinHeight="34" AutomationProperties.Name="New point board X millimeters"/></StackPanel>
                    <StackPanel><TextBlock Text="Board Y (mm)" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="BoardYText" MinHeight="34" AutomationProperties.Name="New point board Y millimeters"/></StackPanel>
                  </UniformGrid>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionBtnBlue}" Content="Add Point" Margin="{StaticResource HmiButtonGap}" Click="OnAddPointClick"/>
                    <Button Style="{StaticResource ActionBtn}" Content="Remove Selected" Click="OnRemoveSelectedPointClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Row="2" Margin="10,0,10,10" Background="#050607" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1">
              <Grid>
                <TextBlock x:Name="EmptyImageText" Text="Load a sample calibration image. Optional: click the preview to fill Image X/Y fields."
                           Style="{StaticResource HmiEmptyStateText}"/>
                <Image x:Name="CalibrationImage" Stretch="Uniform" MouseLeftButtonDown="OnCalibrationImageClick"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
              <TextBlock Text="Calibration Points" Style="{StaticResource HmiSectionHeaderText}"/>
            </Border>
            <Grid Grid.Row="1">
              <!-- Coordinate frames stay separately labeled: image pixels vs board millimeters. -->
              <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" Style="{StaticResource HmiTable}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding No}" Width="56" MinWidth="56"/>
                  <DataGridTextColumn Header="Image X (px)" Binding="{Binding ImageXDisplay}" Width="*" MinWidth="120"/>
                  <DataGridTextColumn Header="Image Y (px)" Binding="{Binding ImageYDisplay}" Width="*" MinWidth="120"/>
                  <DataGridTextColumn Header="Board X (mm)" Binding="{Binding BoardXDisplay}" Width="*" MinWidth="130"/>
                  <DataGridTextColumn Header="Board Y (mm)" Binding="{Binding BoardYDisplay}" Width="*" MinWidth="130"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="EmptyPointsText"
                         Text="No calibration points yet - click the image to add the first point."
                         Style="{StaticResource HmiEmptyStateText}"/>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource FieldBox}" Margin="8,8,8,0">
              <StackPanel>
                <TextBlock Text="Transform Status" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TransformStatusText" Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource FieldBox}" Margin="8">
              <StackPanel>
                <TextBlock Text="Saved Profile Details" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,6"/>
                <TextBlock x:Name="SavedProfileText" Text="No saved profile loaded." Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
                <TextBlock Text="Coordinate mapping shown in Main Inspection is approximate board-mm evidence for planning only. Stage 2 camera calibration and Stage 3 robot coordinate validation are still required."
                           Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
