<UserControl x:Class="AOI_Monitor.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="2D Calibration Profile / Stage 2 Preparation" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          <TextBlock Text="Define image-to-board point pairs for planning camera/robot coordinate mapping. This is approximate 2D profile data only; no real camera or robot calibration is claimed."
                     Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <Border Style="{StaticResource HmiEvidenceBoundaryOnly}" Margin="0,8,12,0" MaxWidth="720">
            <TextBlock Text="Stage 2 preparation only - not live camera/robot calibration"
                       Foreground="{DynamicResource HmiWarnSoftBrush}"
                       FontSize="{StaticResource HmiFontSizeBody}"
                       FontWeight="ExtraBold"
                       TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HmiRightActionBand}">
          <Button Style="{StaticResource ActionBtnBlue}" Content="Reload Profiles" Margin="{StaticResource HmiButtonGap}" Click="OnReloadProfilesClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Save Profile" Margin="{StaticResource HmiButtonGap}" Click="OnSaveProfileClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.95*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="1.25*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Calibration Profile" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </Border>

          <StackPanel Grid.Row="1" Margin="10">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Saved Profile" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <ComboBox x:Name="ProfileCombo" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Saved calibration profile" DisplayMemberPath="DisplayName" SelectionChanged="OnProfileSelectionChanged" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectionBoxItem}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Profile Name" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <TextBox x:Name="ProfileNameText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Profile name" Text="TBOX 2D Top Calibration"/>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Board Model" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <TextBox x:Name="BoardModelText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Board model" Text="TBOX-MAIN"/>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="View" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <ComboBox x:Name="ViewTypeCombo" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Calibration view" SelectedIndex="0">
                <ComboBoxItem Content="Top" Tag="Top"/>
                <ComboBoxItem Content="Side" Tag="Side"/>
                <ComboBoxItem Content="Bottom" Tag="Bottom"/>
              </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
              <TextBlock Text="Sample Image" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <TextBox x:Name="SampleImagePathText" Grid.Column="1" MinHeight="34" AutomationProperties.Name="Sample image path" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <Button Style="{StaticResource MiniBtn}" Grid.Column="2" Content="Browse" Margin="6,0,0,0" Click="OnBrowseSampleImageClick"/>
            </Grid>

            <Border Style="{StaticResource FieldBox}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Add Calibration Point" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,8"/>
                <UniformGrid Columns="4" Margin="0,0,0,8">
                  <StackPanel Margin="0,0,6,0"><TextBlock Text="Image X" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="ImageXText" MinHeight="34" AutomationProperties.Name="New point image X pixels"/></StackPanel>
                  <StackPanel Margin="0,0,6,0"><TextBlock Text="Image Y" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="ImageYText" MinHeight="34" AutomationProperties.Name="New point image Y pixels"/></StackPanel>
                  <StackPanel Margin="0,0,6,0"><TextBlock Text="Board X mm" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="BoardXText" MinHeight="34" AutomationProperties.Name="New point board X millimeters"/></StackPanel>
                  <StackPanel><TextBlock Text="Board Y mm" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/><TextBox x:Name="BoardYText" MinHeight="34" AutomationProperties.Name="New point board Y millimeters"/></StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource ActionBtnBlue}" Content="Add Point" Margin="{StaticResource HmiButtonGap}" Click="OnAddPointClick"/>
                  <Button Style="{StaticResource ActionBtn}" Content="Remove Selected" Click="OnRemoveSelectedPointClick"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FieldBox}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Transform Status" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TransformStatusText" Text="Add at least two points to calculate an approximate 2D transform." Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Row="3" Margin="10,0,10,10" Background="#050607" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1">
            <Grid>
              <TextBlock x:Name="EmptyImageText" Text="Load a sample calibration image. Optional: click the preview to fill Image X/Y fields."
                         Foreground="#7F8C95" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
              <Image x:Name="CalibrationImage" Stretch="Uniform" MouseLeftButtonDown="OnCalibrationImageClick"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Calibration Points" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="PointsGrid" AutoGenerateColumns="False" Style="{StaticResource HmiTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding No}" Width="56" MinWidth="56"/>
              <DataGridTextColumn Header="Image X" Binding="{Binding ImageXDisplay}" Width="120" MinWidth="120"/>
              <DataGridTextColumn Header="Image Y" Binding="{Binding ImageYDisplay}" Width="120" MinWidth="120"/>
              <DataGridTextColumn Header="Board X" Binding="{Binding BoardXDisplay}" Width="130" MinWidth="130"/>
              <DataGridTextColumn Header="Board Y" Binding="{Binding BoardYDisplay}" Width="130" MinWidth="130"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="3" Style="{StaticResource FieldBox}" Margin="8">
            <StackPanel>
              <TextBlock Text="Saved Profile Details" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,6"/>
              <TextBlock x:Name="SavedProfileText" Text="No saved profile loaded." Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
              <TextBlock Text="Coordinate mapping shown in Main Inspection is approximate board-mm evidence for planning only. Stage 2 camera calibration and Stage 3 robot coordinate validation are still required."
                         Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

