<UserControl x:Class="AOI_Monitor.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*" MinHeight="340"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="32"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="RetentionWarningText"
                       DockPanel.Dock="Right"
                       Text=""
                       Foreground="{DynamicResource HmiWarnSoftBrush}"
                       FontSize="{StaticResource HmiFontSizeBody}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="640"
                       Visibility="Collapsed"
                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            <TextBlock Text="Log Filters" Style="{StaticResource HmiSectionHeaderText}"/>
          </DockPanel>
        </Border>
        <WrapPanel Grid.Row="1" Style="{StaticResource HmiAdaptiveFilterBand}">
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="From" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <DatePicker x:Name="FromDatePicker" Style="{StaticResource HmiFieldDatePicker}" MinHeight="36" VerticalAlignment="Top"/>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="To" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <DatePicker x:Name="ToDatePicker" Style="{StaticResource HmiFieldDatePicker}" MinHeight="36" VerticalAlignment="Top"/>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="Model / Board" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <TextBox x:Name="BoardFilterText" Text=""/>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="Operator" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <TextBox x:Name="OperatorFilterText" Text=""/>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="Result" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ResultFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL" Tag="ALL"/>
              <ComboBoxItem Content="OK" Tag="OK"/>
              <ComboBoxItem Content="REVIEW" Tag="REVIEW"/>
              <ComboBoxItem Content="NG" Tag="NG"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="User Role" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <ComboBox x:Name="RoleFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL" Tag="ALL"/>
              <ComboBoxItem Content="Operator" Tag="Operator"/>
              <ComboBoxItem Content="Engineer" Tag="Engineer"/>
              <ComboBoxItem Content="Admin" Tag="Admin"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
            <TextBlock Text="Audit Action Type" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
            <TextBox x:Name="ActionTypeFilterText" Text="" ToolTip="Examples: LOGIN, EXPORT, MAIN_INSPECTION, ENGINE_CONFIG, CALIBRATION"/>
          </StackPanel>
        </WrapPanel>
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="8,0,8,8">
          <WrapPanel DockPanel.Dock="Right" Style="{StaticResource HmiInlineActionBand}" VerticalAlignment="Center">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Apply Filters" Margin="{StaticResource HmiButtonGap}" Click="OnApplyFiltersClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Clear" Click="OnClearFiltersClick"/>
          </WrapPanel>
          <TextBlock Text="Filter production evidence, operator decisions, exports, and queue activity. Long paths are available through hover tooltips."
                     Style="{StaticResource HmiPageSubtitleText}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <DockPanel>
            <TextBlock x:Name="LogSummaryText" DockPanel.Dock="Right" Text="No records loaded" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
            <TextBlock Text="SQLite Logs" Style="{StaticResource HmiSectionHeaderText}"/>
          </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Background="{DynamicResource HmiSurfaceBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}">
          <TabItem Header="Inspection History">
            <DataGrid x:Name="InspectionGrid" CanUserSortColumns="True" Style="{StaticResource HmiDenseTable}" MinWidth="1160">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Board" Binding="{Binding BoardProgram}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Verdict}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" SortMemberPath="DifferenceScore" Width="84" MinWidth="84"/>
                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" SortMemberPath="Confidence" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Engine" Binding="{Binding InspectionEngine}" Width="170" MinWidth="170"/>
                <DataGridTextColumn Header="Defect" Binding="{Binding SuggestedDefect}" Width="160" MinWidth="160"/>
                <DataGridTextColumn Header="Image" Binding="{Binding ImageName}" Width="280" MinWidth="280"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Review / Disposition Events" ToolTip="Operator review and disposition events">
            <DataGrid x:Name="ReviewGrid" CanUserSortColumns="True" Style="{StaticResource HmiDenseTable}" MinWidth="780">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="EventTimeUtc" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Disposition" Binding="{Binding Disposition}" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="290" MinWidth="290"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Export History">
            <DataGrid x:Name="ExportGrid" CanUserSortColumns="True" Style="{StaticResource HmiDenseTable}" MinWidth="1140" ToolTip="Export file paths are available through row/cell hover when truncated.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ExportType}" Width="160" MinWidth="160"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="96" MinWidth="96"/>
                <DataGridTextColumn Header="Verified" Binding="{Binding VerificationStatus}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="SHA-256" Binding="{Binding VerificationShaDisplay}" Width="124" MinWidth="124"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Audit ID" Binding="{Binding AuditEventDisplay}" Width="100" MinWidth="100"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="290" MinWidth="290"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Audit Trail">
            <DataGrid x:Name="AuditGrid" CanUserSortColumns="True" Style="{StaticResource HmiDenseTable}" MinWidth="1160" ToolTip="Traceability means the audit path from user, board, result, export, and upload event.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC Time" Binding="{Binding TimestampUtcDisplay}" SortMemberPath="TimestampUtc" Width="145" MinWidth="145"/>
                <DataGridTextColumn Header="Local Time" Binding="{Binding LocalTimestampDisplay}" Width="145" MinWidth="145"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Role" Binding="{Binding UserRole}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionCategory}" Width="150" MinWidth="150"/>
                <DataGridTextColumn Header="Related ID" Binding="{Binding RelatedEntityDisplay}" Width="150" MinWidth="150"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding ActionDetail}" Width="240" MinWidth="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="MES Upload Queue" ToolTip="MES means factory traceability system. This queue shows results waiting to upload, failed uploads, and sent records.">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Status" Foreground="{DynamicResource HmiTextLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MesQueueStatusFilter" Width="150" SelectionChanged="OnMesQueueStatusFilterChanged" SelectedIndex="0">
                  <ComboBoxItem Content="All" Tag="All"/>
                  <ComboBoxItem Content="Pending" Tag="Pending"/>
                  <ComboBoxItem Content="Failed" Tag="Failed"/>
                  <ComboBoxItem Content="Sent" Tag="Sent"/>
                  <ComboBoxItem Content="Abandoned" Tag="Abandoned"/>
                </ComboBox>
              </StackPanel>
              <DataGrid x:Name="MesSpoolGrid" CanUserSortColumns="True" SelectionMode="Extended" Style="{StaticResource HmiDenseTable}" MinWidth="1120" ToolTip="Endpoint and last-error text may be long; hover the row/cell to inspect the full value.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="130" MinWidth="130"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding PayloadType}" Width="140" MinWidth="140"/>
                  <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="105" MinWidth="105"/>
                  <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="115" MinWidth="115"/>
                  <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" MinWidth="90"/>
                  <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointUrl}" Width="190" MinWidth="190"/>
                  <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="90" MinWidth="90"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="96" MinWidth="96"/>
                  <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="260" MinWidth="260"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Central Evidence Sync" ToolTip="Central Sync copies selected evidence to a configured folder or service. It does not approve factory readiness by itself.">
            <DataGrid x:Name="CentralSyncGrid" CanUserSortColumns="True" SelectionMode="Extended" Style="{StaticResource HmiDenseTable}" MinWidth="1080" ToolTip="Endpoint/folder summaries are intentionally compact; hover to inspect the full path or endpoint.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="130" MinWidth="130"/>
                <DataGridTextColumn Header="Item Type" Binding="{Binding ItemType}" Width="145" MinWidth="145"/>
                <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="100" MinWidth="100"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointOrFolder}" Width="220" MinWidth="220"/>
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="96" MinWidth="96"/>
                <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="240" MinWidth="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="420"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="2.2*"/>
        </Grid.ColumnDefinitions>
        <!-- Minimal status line for this window's own exports/utilities. The readiness
             status block (archive policy, latest package, build evidence, client demo gate)
             lives on the Readiness & QA window with the rest of the readiness context. -->
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ProgressBar x:Name="WorkProgressBar" Width="190" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelWorkButton" Style="{StaticResource MiniBtn}" Content="Cancel" IsEnabled="False" Click="OnCancelWorkClick"/>
          </StackPanel>
        </StackPanel>
        <!-- Action groups wrap horizontally: a tall stacked column here starves the
             star row holding the log tabs (an Auto row takes all it asks for). -->
        <WrapPanel Grid.Column="2" Orientation="Horizontal">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,8,8" MaxWidth="640" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Evidence Exports" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Inspection History CSV" Margin="0,0,6,6" Click="OnExportInspectionHistoryClick"/>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Review Log CSV" Margin="0,0,6,6" Click="OnExportReviewLogClick"/>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Audit Trail CSV" Margin="0,0,6,6" Click="OnExportAuditTrailClick"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Annotated Overlays" Margin="0,0,6,6" Click="OnExportAnnotatedOverlaysClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Verify Selected Export" Margin="0,0,6,6" Click="OnVerifySelectedExportClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,8,8" MaxWidth="640" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Database and Image Index" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtn}" Content="DB Integrity" Margin="0,0,6,6" Click="OnRunDbIntegrityCheckClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Database Health" Margin="0,0,6,6" Click="OnOpenDatabaseHealthClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Verify Paths" Margin="0,0,6,6" Click="OnVerifyImagePathsClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Rebuild Image Index" Margin="0,0,6,6" Click="OnRebuildImageIndexClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Lock Recipe" Margin="0,0,6,6" Click="OnLockActiveRecipeClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,8,8" MaxWidth="640" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="MES Traceability Queue" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Send Result to Traceability System" Margin="0,0,6,6" Click="OnUploadMesMockClick" ToolTip="MES means factory traceability system. Mock mode creates local evidence only."/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Run Traceability Test" Margin="0,0,6,6" Click="OnRunTraceabilityTestClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected Upload" Margin="0,0,6,6" Click="OnRetrySelectedMesSpoolClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Waiting Uploads" Margin="0,0,6,6" Click="OnRetryMesSpoolClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Queue Report" Margin="0,0,6,6" Click="OnExportMesQueueReportClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export MES Contract" Margin="0,0,6,6" Click="OnExportMesContractClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Mark MES Abandoned" Margin="0,0,6,6" Click="OnAbandonMesSpoolClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,8,8" MaxWidth="640" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Central Evidence Sync" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Central Sync" Margin="0,0,6,6" Click="OnQueueCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected Central" Margin="0,0,6,6" Click="OnRetrySelectedCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Central" Margin="0,0,6,6" Click="OnRetryCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Central Sync Report" Margin="0,0,6,6" Click="OnExportCentralSyncReportClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

