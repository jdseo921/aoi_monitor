<UserControl x:Class="AOI_Monitor.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <UserControl.Resources>
    <Style x:Key="CompareResultChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Judgement}" Value="NG">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Judgement}" Value="Review">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Judgement}" Value="OK">
          <Setter Property="Background" Value="#14311D"/>
          <Setter Property="BorderBrush" Value="#377849"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CompareResultChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Judgement}" Value="NG">
          <Setter Property="Foreground" Value="{DynamicResource HmiNgSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Judgement}" Value="Review">
          <Setter Property="Foreground" Value="{DynamicResource HmiWarnSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Judgement}" Value="OK">
          <Setter Property="Foreground" Value="{DynamicResource HmiOkSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CompareFooterLabelText" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextDimBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="CompareFooterValueText" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LineHeight" Value="25"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource FactoryScrollablePage}">
  <Grid Margin="8" MinHeight="665">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="0.62*" MinWidth="330" MaxWidth="520"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══ LEFT: Defect PCBA ══ -->
    <Border Grid.Column="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="OpenDefectImageViewerButton"
                      Style="{StaticResource MiniBtn}"
                      Content="Large Image"
                      MinWidth="112"
                      Margin="0,0,6,0"
                      Click="OnOpenDefectImageViewerClick"/>
              <TextBlock x:Name="DefectSubtitleText"
                         Text="IMG_0241 / AI OK / GT NG"
                         Foreground="{DynamicResource HmiTextLabelBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="210"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Defect Sample" FontWeight="ExtraBold" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource ChipPurple}" Margin="8,0,0,0">
                <TextBlock Text="Demo Board" Foreground="#F1D8FF" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold"/>
              </Border>
            </WrapPanel>
          </DockPanel>
        </Border>
        <!-- Defect PCB view -->
        <Border x:Name="DefectImageViewport" Grid.Row="1" Margin="8" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" Background="{DynamicResource HmiSurfaceBrush}" ClipToBounds="True">
          <Grid>
          <Viewbox x:Name="DefectCanvasViewbox" Stretch="Uniform">
          <Viewbox.LayoutTransform>
            <ScaleTransform x:Name="DefectZoomTransform" ScaleX="1" ScaleY="1"/>
          </Viewbox.LayoutTransform>
          <Canvas Width="500" Height="380">
            <Border Canvas.Left="40" Canvas.Top="34" Width="390" Height="280" BorderBrush="#5A8C59" BorderThickness="2">
              <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,34,34" ViewportUnits="Absolute" Stretch="None">
                  <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="#164321"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,34,34"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#1B5A28" Thickness="1"/></GeometryDrawing.Pen>
                      <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="33.5,0" EndPoint="33.5,34"/><LineGeometry StartPoint="0,33.5" EndPoint="34,33.5"/></GeometryGroup></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup></DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.Background>
            </Border>
            <Border Canvas.Left="87"  Canvas.Top="68"  Width="120" Height="70" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="U101" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="280" Canvas.Top="68"  Width="92"  Height="58" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="CN8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="165" Canvas.Top="142" Width="168" Height="82" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="U107" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="220" Canvas.Top="180" Width="142" Height="64" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="SH1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="95"  Canvas.Top="185" Width="88"  Height="52" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="D12" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <!-- ROI -->
            <Rectangle Canvas.Left="153" Canvas.Top="133" Width="202" Height="108" Stroke="#E1A334" StrokeThickness="1.5" Fill="Transparent" StrokeDashArray="4 3"/>
            <!-- Defect box -->
            <Canvas Canvas.Left="232" Canvas.Top="153" Width="62" Height="46">
              <Rectangle Width="62" Height="46" Stroke="#F13B3F" StrokeThickness="2" Fill="Transparent"/>
              <Border Canvas.Left="-2" Canvas.Top="-21" Background="#F13B3F" Padding="5,2">
                <TextBlock Text="U107 BRIDGE" Foreground="White" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="ExtraBold"/>
              </Border>
            </Canvas>
            <!-- Diff box -->
            <Canvas Canvas.Left="222" Canvas.Top="148" Width="76" Height="58">
              <Rectangle Width="76" Height="58" Stroke="#E1A334" StrokeThickness="2" Fill="Transparent"/>
              <Border Canvas.Left="-2" Canvas.Top="-21" Background="#E1A334" Padding="5,2">
                <TextBlock Text="DIFF" Foreground="#111111" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="ExtraBold"/>
              </Border>
            </Canvas>
            <Line X1="0" Y1="173" X2="500" Y2="173" Stroke="#3C6480" StrokeThickness="1" Opacity="0.5"/>
            <Line X1="290" Y1="0" X2="290" Y2="380" Stroke="#3C6480" StrokeThickness="1" Opacity="0.5"/>
          </Canvas>
          </Viewbox>
          <Image x:Name="DefectActualImage" Visibility="Collapsed" Stretch="Uniform"/>
          </Grid>
        </Border>
        <!-- Footer fields -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="8" Rows="2">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,5"><StackPanel><TextBlock Text="Sample" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="IMG_0241" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,5"><StackPanel><TextBlock Text="RefDes" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="U107" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,5"><StackPanel><TextBlock Text="FOV" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="TOP-03" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Risk" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="Possible Escape" Style="{StaticResource CompareFooterValueText}" Foreground="{DynamicResource HmiNgStrongBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Defect" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="Solder Bridge" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Shift" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="A" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
        </UniformGrid>
      </Grid>
    </Border>

    <!-- ══ CENTER: Controls + Findings ══ -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Sync / controls -->
      <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Alignment / Difference Control" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </Border>
          <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Toolbar -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
              <Button Style="{StaticResource MiniBtn}" Content="Sync Zoom" Margin="0,0,5,5" Click="OnSyncZoomClick"/>
              <Button Style="{StaticResource MiniBtn}" Content="Sync Pan" Margin="0,0,5,5" Click="OnSyncPanClick"/>
              <Button Style="{StaticResource MiniBtnAmber}" Content="Show Difference" Margin="0,0,5,5" Click="OnShowDifferenceClick"/>
              <Button Style="{StaticResource MiniBtn}" Content="Defect Overlay" Margin="0,0,5,5" Click="OnAiOverlayClick"/>
              <Button Style="{StaticResource MiniBtn}" Content="GT Overlay" Margin="0,0,5,5" Click="OnGtOverlayClick"/>
              <Button Style="{StaticResource ActionBtnGreen}" Content="Export Pair" MinWidth="120" MinHeight="40" Click="OnExportPairClick"/>
            </WrapPanel>
            <!-- Score -->
            <Border Grid.Row="1" Background="#13191D" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" MinHeight="78" Padding="8" Margin="0,0,0,6">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                <TextBlock x:Name="DiffScoreText" Text="87%" FontSize="32" FontWeight="ExtraBold" Foreground="{DynamicResource HmiTextBrush}" TextAlignment="Center"/>
                <TextBlock Text="Difference Score" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextAlignment="Center"/>
                <TextBlock x:Name="DiffSummaryText" Text="ROI mismatch vs golden" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" x:Name="LearnedArtifactsPanel" Background="#13191D" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" MinHeight="118" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="LearnedCompareEvidenceText" Text="Learned PCB Visual Model evidence unavailable." Foreground="{DynamicResource HmiSimulatedBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
                <UniformGrid Columns="2" Height="78" Margin="0,6,0,0">
                  <Border Background="#080A0C" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Margin="0,0,5,0">
                    <Grid>
                      <Image x:Name="LearnedToleranceImage" Stretch="Uniform"/>
                      <TextBlock Text="Tolerance Map" Foreground="#DCE5EB" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" Margin="6" VerticalAlignment="Bottom"/>
                    </Grid>
                  </Border>
                  <Border Background="#080A0C" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="LearnedAnomalyMapImage" Stretch="Uniform"/>
                      <TextBlock Text="Anomaly Threshold Map" Foreground="#DCE5EB" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" Margin="6" VerticalAlignment="Bottom"/>
                    </Grid>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>
            <!-- Alignment steps are a planned feature, shown as one amber planned-feature note. -->
            <Border Grid.Row="3" Style="{StaticResource HmiEvidenceBoundaryOnly}" MaxWidth="520">
              <TextBlock Text="Alignment steps - planned, not yet interactive"
                         Foreground="{DynamicResource HmiWarnSoftBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         FontWeight="ExtraBold"
                         TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Findings -->
      <Border Grid.Row="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <Border x:Name="FindingsSourceChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="#2A1740" BorderBrush="#8F5FD1">
                <TextBlock x:Name="FindingsSourceText" Text="Demo Data" Foreground="#F1D8FF" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold"/>
              </Border>
              <TextBlock Text="Comparison Findings" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <DataGrid Grid.Row="1"
                    x:Name="FindingsGrid"
                    BorderThickness="0"
                    MinWidth="0"
                    MaxHeight="480"
                    Style="{StaticResource HmiDenseTable}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Region"  Binding="{Binding Region}"   Width="105" MinWidth="105" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                <DataGridTextColumn Header="Defect"  Binding="{Binding Defect}"   Width="118" MinWidth="118"/>
                <DataGridTextColumn Header="Golden"  Binding="{Binding Golden}"   Width="120" MinWidth="120"/>
                <DataGridTemplateColumn Header="Result" Width="80" MinWidth="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CompareResultChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                        <TextBlock Text="{Binding Judgement}" Style="{StaticResource CompareResultChipText}"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ══ RIGHT: Golden PCBA ══ -->
    <Border Grid.Column="4" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="OpenGoldenImageViewerButton"
                      Style="{StaticResource MiniBtn}"
                      Content="Large Image"
                      MinWidth="112"
                      Margin="0,0,6,0"
                      Click="OnOpenGoldenImageViewerClick"/>
              <TextBlock x:Name="GoldenSubtitleText"
                         Text="IMG_GOLD_0241 / verified OK"
                         Foreground="{DynamicResource HmiTextLabelBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="210"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Golden Reference" FontWeight="ExtraBold" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource ChipPurple}" Margin="8,0,0,0">
                <TextBlock Text="Demo Board" Foreground="#F1D8FF" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold"/>
              </Border>
            </WrapPanel>
          </DockPanel>
        </Border>
        <!-- Golden PCB view (slightly desaturated) -->
        <Border x:Name="GoldenImageViewport" Grid.Row="1" Margin="8" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" Background="{DynamicResource HmiSurfaceBrush}" ClipToBounds="True" Opacity="0.88">
          <Grid>
          <Viewbox x:Name="GoldenCanvasViewbox" Stretch="Uniform">
          <Viewbox.LayoutTransform>
            <ScaleTransform x:Name="GoldenZoomTransform" ScaleX="1" ScaleY="1"/>
          </Viewbox.LayoutTransform>
          <Canvas Width="500" Height="380">
            <Border Canvas.Left="40" Canvas.Top="34" Width="390" Height="280" BorderBrush="#5A8C59" BorderThickness="2">
              <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,34,34" ViewportUnits="Absolute" Stretch="None">
                  <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="#164321"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,34,34"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#1B5A28" Thickness="1"/></GeometryDrawing.Pen>
                      <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="33.5,0" EndPoint="33.5,34"/><LineGeometry StartPoint="0,33.5" EndPoint="34,33.5"/></GeometryGroup></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingGroup></DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.Background>
            </Border>
            <Border Canvas.Left="87"  Canvas.Top="68"  Width="120" Height="70" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="U101" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="280" Canvas.Top="68"  Width="92"  Height="58" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="CN8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="165" Canvas.Top="142" Width="168" Height="82" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="U107" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="220" Canvas.Top="180" Width="142" Height="64" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="SH1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <Border Canvas.Left="95"  Canvas.Top="185" Width="88"  Height="52" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1"><TextBlock Text="D12" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}"/></Border>
            <!-- Golden ROI (dashed purple: demo illustration, not validated evidence) -->
            <Rectangle Canvas.Left="153" Canvas.Top="133" Width="202" Height="108" Stroke="#C084FC" StrokeThickness="1.5" Fill="#14C084FC" StrokeDashArray="4 3"/>
            <Rectangle Canvas.Left="232" Canvas.Top="153" Width="62"  Height="46"  Stroke="#C084FC" StrokeThickness="1.5" Fill="#14C084FC" StrokeDashArray="4 3"/>
            <Line X1="0" Y1="173" X2="500" Y2="173" Stroke="#3C6480" StrokeThickness="1" Opacity="0.5"/>
            <Line X1="290" Y1="0" X2="290" Y2="380" Stroke="#3C6480" StrokeThickness="1" Opacity="0.5"/>
          </Canvas>
          </Viewbox>
          <Image x:Name="GoldenLearnedReferenceImage" Visibility="Collapsed" Stretch="Uniform"/>
          </Grid>
        </Border>
        <!-- Footer fields -->
        <!-- RefDes/FOV are shown once, in the defect-side footer; the golden footer keeps
             only golden-specific fields. -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="8" Rows="2">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,5"><StackPanel><TextBlock Text="Sample" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="IMG_GOLD_0241" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,5"><StackPanel><TextBlock Text="Status" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="Demo OK" Style="{StaticResource CompareFooterValueText}" Foreground="{DynamicResource HmiSimulatedBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Program" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="TBOX_TOP_V1.2" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
          <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Captured" Style="{StaticResource CompareFooterLabelText}"/><TextBlock Text="Baseline" Style="{StaticResource CompareFooterValueText}"/></StackPanel></Border>
        </UniformGrid>
      </Grid>
    </Border>

  </Grid>
  </ScrollViewer>
</UserControl>

