<UserControl x:Class="AOI_Monitor.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <UserControl.Resources>
    <Style x:Key="LibraryRiskChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Possible Escape">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Background" Value="#172A39"/>
          <Setter Property="BorderBrush" Value="#477CA5"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LibraryRiskChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Possible Escape">
          <Setter Property="Foreground" Value="{DynamicResource HmiNgSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Foreground" Value="{DynamicResource HmiWarnSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Foreground" Value="{DynamicResource HmiInfoSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Collapsed-by-default panel expander: the HmiPanelHeader strip doubles as the
         toggle so demoted reference/planned content keeps the shared header vocabulary.
         Candidate for promotion into FactoryHmiLayout.xaml once a second view needs it. -->
    <Style x:Key="LibraryPanelExpander" TargetType="Expander">
      <Setter Property="IsExpanded" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel LastChildFill="True">
              <ToggleButton DockPanel.Dock="Top"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderStrip" Style="{StaticResource HmiPanelHeader}">
                      <DockPanel>
                        <!-- Direction glyph + collapsed/expanded content are the state signals;
                             color is never the only one. -->
                        <Path x:Name="ExpandGlyph"
                              DockPanel.Dock="Left"
                              Data="M 0,0 L 10,6 L 0,12 Z"
                              Fill="{DynamicResource HmiTextLabelBrush}"
                              VerticalAlignment="Center"
                              Margin="{StaticResource HmiButtonGap}"
                              RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                          </Path.RenderTransform>
                        </Path>
                        <ContentPresenter VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ExpandGlyph" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90"/>
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderStrip" Property="Background" Value="{DynamicResource HmiRaisedBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Record actions + demoted prototype filters. The action band leads; the inert
         filter combos are planned-only and live behind a collapsed "Filters" expander
         so they cannot read as working query controls. -->
    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="Prototype Filters" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Database Filter Console" Style="{StaticResource HmiSectionHeaderText}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="8">
          <WrapPanel Style="{StaticResource HmiAdaptiveFilterActionBand}" Margin="{StaticResource HmiRowGap}">
            <Button Style="{StaticResource ActionBtn}" Content="Open Record" Margin="{StaticResource HmiButtonGap}" Click="OnOpenRecordClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Batch Import" Margin="{StaticResource HmiButtonGap}" Click="OnBatchImportClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Compare Golden" Margin="{StaticResource HmiButtonGap}" Click="OnCompareGoldenClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Candidate" Margin="{StaticResource HmiButtonGap}" Click="OnAddToTrainingClick"/>
            <Button Style="{StaticResource ActionBtnAmber}" Content="Batch Relabel" Margin="{StaticResource HmiButtonGap}" Click="OnBatchRelabelClick"/>
            <Button Style="{StaticResource ActionBtnGreen}" Content="Export Selected" Margin="{StaticResource HmiButtonGap}" Click="OnExportSelectedClick"/>
          </WrapPanel>
          <Expander Style="{StaticResource LibraryPanelExpander}"
                    AutomationProperties.Name="Filters"
                    Margin="{StaticResource HmiRowGap}">
            <Expander.Header>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="Not configured" Foreground="{DynamicResource HmiTextLabelBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
                </Border>
                <TextBlock Text="Filters" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              </DockPanel>
            </Expander.Header>
            <StackPanel Margin="8">
              <TextBlock Text="Planned filters. Filtering is not configured in the Stage 1 prototype; the table lists records unfiltered."
                         Foreground="{DynamicResource HmiTextLabelBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         TextWrapping="Wrap"
                         Margin="{StaticResource HmiRowGap}"/>
              <WrapPanel Style="{StaticResource HmiAdaptiveFilterBand}" Margin="0">
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Board Model" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Defect Type" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Risk Class" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Review Status" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Recipe Version" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
                <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
                  <TextBlock Text="Image Link State" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
                  <ComboBox IsEnabled="False"/>
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </Expander>
          <TextBlock x:Name="ImportStatusText"
                     Text="Imported images are loaded from the local SQLite image table."
                     Foreground="{DynamicResource HmiTextLabelBrush}"
                     FontSize="{StaticResource HmiFontSizeBody}"
                     TextWrapping="Wrap"/>
          <!-- Progress + Cancel appear only while an import is running (BeginImport/EndImport). -->
          <StackPanel x:Name="ImportProgressPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="ImportProgressBar" Width="180" Height="12" Minimum="0" Maximum="100" Value="0" Margin="{StaticResource HmiButtonGap}" VerticalAlignment="Center"/>
            <Button x:Name="CancelImportButton" Style="{StaticResource MiniBtn}" Content="Cancel" IsEnabled="False" Click="OnCancelImportClick"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Records table -->
    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <DockPanel>
            <Border DockPanel.Dock="Right" x:Name="RecordsSourceChip" Style="{StaticResource Chip}" Padding="6,1" VerticalAlignment="Center">
              <TextBlock x:Name="RecordsSourceText" Text="SQLite Records" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Inspection Records" Style="{StaticResource HmiSectionHeaderText}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <!-- Abbreviations are explained by the per-header tooltips (HmiHeaderRefDesTemplate /
             HmiHeaderInspectionResultTemplate / HmiHeaderGroundTruthTemplate). -->
        <DataGrid Grid.Row="1"
                  x:Name="RecordsGrid"
                  SelectionChanged="OnRecordsSelectionChanged"
                  MinWidth="1130"
                  Style="{StaticResource HmiDenseTable}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Sample"   Binding="{Binding Sample}"      Width="128" MinWidth="128"/>
            <DataGridTextColumn Header="Board"    Binding="{Binding Board}"       Width="118" MinWidth="118"/>
            <DataGridTextColumn Header="RefDes"   Binding="{Binding RefDes}"      Width="96" MinWidth="96" HeaderTemplate="{StaticResource HmiHeaderRefDesTemplate}"/>
            <DataGridTextColumn Header="Defect"   Binding="{Binding Defect}"      Width="150" MinWidth="150"/>
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}"    Width="112" MinWidth="112"/>
            <DataGridTextColumn Header="AI"       Binding="{Binding AiResult}"    Width="76" MinWidth="76" HeaderTemplate="{StaticResource HmiHeaderInspectionResultTemplate}"/>
            <DataGridTextColumn Header="GT"       Binding="{Binding GroundTruth}" Width="76" MinWidth="76" HeaderTemplate="{StaticResource HmiHeaderGroundTruthTemplate}"/>
            <DataGridTemplateColumn Header="Risk" Width="150" MinWidth="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LibraryRiskChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource LibraryRiskChipText}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Image"    Binding="{Binding ImageLink}"   Width="100" MinWidth="100"/>
            <DataGridTextColumn Header="Updated"  Binding="{Binding Date}"        Width="124" MinWidth="124"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Schema reference: informs, but does not drive an operator decision, so it stays
         collapsed by default. All rows are kept; the amber truthfulness chip stays visible
         on the header even while collapsed. -->
    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Expander Style="{StaticResource LibraryPanelExpander}"
                AutomationProperties.Name="Database Transparency (reference)">
        <Expander.Header>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource ChipAmber}" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="Static Schema Reference" Foreground="{DynamicResource HmiWarnSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Database Transparency (reference)" Style="{StaticResource HmiSectionHeaderText}" VerticalAlignment="Center"/>
          </DockPanel>
        </Expander.Header>
        <DataGrid x:Name="SchemaGrid" Style="{StaticResource HmiDenseTable}" MinWidth="720">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Table"   Binding="{Binding Table}"   Width="150" MinWidth="150"/>
            <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="470" MinWidth="470" ElementStyle="{StaticResource HmiDataGridCellText}"/>
            <DataGridTextColumn Header="Status"  Binding="{Binding Status}"  Width="96" MinWidth="96"/>
          </DataGrid.Columns>
        </DataGrid>
      </Expander>
    </Border>
  </Grid>
</UserControl>
