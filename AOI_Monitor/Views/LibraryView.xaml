<UserControl x:Class="AOI_Monitor.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <UserControl.Resources>
    <Style x:Key="LibraryRiskChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Possible Escape">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Background" Value="#172A39"/>
          <Setter Property="BorderBrush" Value="#477CA5"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LibraryRiskChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Possible Escape">
          <Setter Property="Foreground" Value="{DynamicResource HmiNgSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Foreground" Value="{DynamicResource HmiWarnSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Foreground" Value="{DynamicResource HmiInfoSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Filters + toolbar -->
    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
              <TextBlock Text="Prototype Filters" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Database Filter Console" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="8">
          <WrapPanel Style="{StaticResource HmiAdaptiveFilterBand}" Margin="0">
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Board Model" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>TBOX-MAIN</ComboBoxItem></ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Defect Type" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>All defect types</ComboBoxItem></ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Risk Class" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>Possible Escape first</ComboBoxItem></ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Review Status" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>Pending / Verified</ComboBoxItem></ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Recipe Version" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>TBOX_TOP_V1.2</ComboBoxItem></ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource HmiAdaptiveFilterField}">
              <TextBlock Text="Image Link State" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
              <ComboBox SelectedIndex="0"><ComboBoxItem>Linked only</ComboBoxItem></ComboBox>
            </StackPanel>
          </WrapPanel>
          <WrapPanel Style="{StaticResource HmiAdaptiveFilterActionBand}">
            <Button Style="{StaticResource ActionBtn}" Content="Open Record" Margin="{StaticResource HmiButtonGap}" Click="OnOpenRecordClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Batch Import" Margin="{StaticResource HmiButtonGap}" Click="OnBatchImportClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Compare Golden" Margin="{StaticResource HmiButtonGap}" Click="OnCompareGoldenClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Candidate" Margin="{StaticResource HmiButtonGap}" Click="OnAddToTrainingClick"/>
            <Button Style="{StaticResource ActionBtnAmber}" Content="Batch Relabel" Margin="{StaticResource HmiButtonGap}" Click="OnBatchRelabelClick"/>
            <Button Style="{StaticResource ActionBtnGreen}" Content="Export Selected" Margin="{StaticResource HmiButtonGap}" Click="OnExportSelectedClick"/>
          </WrapPanel>
          <TextBlock x:Name="ImportStatusText"
                     Text="Imported images are loaded from the local SQLite image table."
                     Foreground="{DynamicResource HmiTextLabelBrush}"
                     FontSize="{StaticResource HmiFontSizeBody}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ProgressBar x:Name="ImportProgressBar" Width="180" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelImportButton" Style="{StaticResource MiniBtn}" Content="Cancel" IsEnabled="False" Click="OnCancelImportClick"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Records table -->
    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <Border DockPanel.Dock="Right" x:Name="RecordsSourceChip" Style="{StaticResource Chip}" Padding="6,1">
              <TextBlock x:Name="RecordsSourceText" Text="SQLite Records" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Inspection Records" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </DockPanel>
        </Border>
        <!-- Abbreviations are explained by the per-header tooltips (HmiHeaderRefDesTemplate /
             HmiHeaderInspectionResultTemplate / HmiHeaderGroundTruthTemplate). -->
        <DataGrid Grid.Row="1"
                  x:Name="RecordsGrid"
                  SelectionChanged="OnRecordsSelectionChanged"
                  MinWidth="1130"
                  Style="{StaticResource HmiDenseTable}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Sample"   Binding="{Binding Sample}"      Width="128" MinWidth="128"/>
            <DataGridTextColumn Header="Board"    Binding="{Binding Board}"       Width="118" MinWidth="118"/>
            <DataGridTextColumn Header="RefDes"   Binding="{Binding RefDes}"      Width="96" MinWidth="96" HeaderTemplate="{StaticResource HmiHeaderRefDesTemplate}"/>
            <DataGridTextColumn Header="Defect"   Binding="{Binding Defect}"      Width="150" MinWidth="150"/>
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}"    Width="112" MinWidth="112"/>
            <DataGridTextColumn Header="AI"       Binding="{Binding AiResult}"    Width="76" MinWidth="76" HeaderTemplate="{StaticResource HmiHeaderInspectionResultTemplate}"/>
            <DataGridTextColumn Header="GT"       Binding="{Binding GroundTruth}" Width="76" MinWidth="76" HeaderTemplate="{StaticResource HmiHeaderGroundTruthTemplate}"/>
            <DataGridTemplateColumn Header="Risk" Width="150" MinWidth="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LibraryRiskChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource LibraryRiskChipText}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Image"    Binding="{Binding ImageLink}"   Width="100" MinWidth="100"/>
            <DataGridTextColumn Header="Updated"  Binding="{Binding Date}"        Width="124" MinWidth="124"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Schema -->
    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource ChipAmber}" Padding="6,1">
              <TextBlock Text="Static Schema Reference" Foreground="{DynamicResource HmiWarnSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <TextBlock Text="Database Transparency" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="SchemaGrid" Style="{StaticResource HmiDenseTable}" MinWidth="720">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Table"   Binding="{Binding Table}"   Width="150" MinWidth="150"/>
            <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="470" MinWidth="470" ElementStyle="{StaticResource HmiDataGridCellText}"/>
            <DataGridTextColumn Header="Status"  Binding="{Binding Status}"  Width="96" MinWidth="96"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

