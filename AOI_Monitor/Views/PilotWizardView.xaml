<UserControl x:Class="AOI_Monitor.Views.PilotWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Deployment Profile" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,4"/>
          <ComboBox x:Name="ProfileCombo" MinHeight="34"/>
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="SessionSummaryText"
                   Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <WrapPanel Grid.Column="3" VerticalAlignment="Center">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Start New Pilot" Margin="{StaticResource HmiButtonGap}" Click="OnStartNewClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Resume Latest" Margin="{StaticResource HmiButtonGap}" Click="OnResumeClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Export Bundle" Click="OnExportBundleClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Customer Pilot Evidence Steps" Style="{StaticResource HmiSectionHeaderText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ActionBtnAmber}" Content="Waive Selected" Click="OnWaiveSelectedClick"
                    ToolTip="Records an audited engineer waiver for the step selected in the table below."/>
          </Grid>
        </Border>
        <!-- Session roll-up: collapsed until a pilot session exists. The steps table below is
             the single source of step identity, status, and action. -->
        <UniformGrid Grid.Row="1" x:Name="SummaryTilesPanel" Columns="5" Margin="8" Visibility="Collapsed">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Current Step" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="CurrentStepText" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Blockers" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="BlockersText" Foreground="{DynamicResource HmiNgSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Evidence Required" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="EvidenceRequiredText" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Next Action" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="NextActionText" Foreground="{DynamicResource HmiWarnSoftBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="Waived" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="WaivedStatusText" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Grid Grid.Row="2" Margin="8,0,8,8">
          <DataGrid x:Name="StepsGrid" CanUserSortColumns="False" AutoGenerateColumns="False" Style="{StaticResource HmiDenseTable}" MinWidth="0"
                    ToolTip="Each row is a readiness gate. Waived items require audited engineering justification and do not imply production readiness.">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="{Binding StatusBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding StepOrder}" Width="60" MinWidth="60"/>
              <DataGridTextColumn Header="Step" Binding="{Binding StepName}" Width="240" MinWidth="240"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" MinWidth="120"/>
              <DataGridTextColumn Header="Evidence" Binding="{Binding EvidencePath}" Width="2*" MinWidth="120"
                                  ElementStyle="{StaticResource FactoryTrimmedTextWithTooltip}"/>
              <DataGridTextColumn Header="Messages" Binding="{Binding MessagesDisplay}" Width="*" MinWidth="120"
                                  ElementStyle="{StaticResource FactoryTrimmedTextWithTooltip}"/>
              <DataGridCheckBoxColumn Header="Waived" Binding="{Binding Waived}" Width="96" MinWidth="96"/>
              <DataGridTemplateColumn Header="Run" Width="Auto" MinWidth="136">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ActionBtn}" Content="Run" Margin="4,2" Click="OnRunStepClick"
                            ToolTip="{Binding RunActionName}" AutomationProperties.Name="{Binding RunActionName}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="StepsEmptyStateText" Style="{StaticResource HmiEmptyStateText}"
                     Text="No pilot session - press Start New Pilot to begin."/>
        </Grid>
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" x:Name="StatusText" MinHeight="{StaticResource HmiFontSizeBody}"
               Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
