<UserControl x:Class="AOI_Monitor.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
  <UserControl.Resources>
    <Style x:Key="HomeModuleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="116"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Background" Value="{DynamicResource Frame2Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="HomeGroupHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextLabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <DataTemplate x:Key="HomeModuleTileTemplate">
      <Button Style="{StaticResource HomeModuleButton}"
              AutomationProperties.Name="{Binding Title}"
              IsEnabled="{Binding IsEnabled}"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding Key}">
        <Grid Margin="12,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34"
                  Height="34"
                  Background="{DynamicResource BlueBrush}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Number}"
                       Foreground="White"
                       FontSize="{StaticResource HmiFontSizeBody}"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="{StaticResource HmiFontSizeBody}"
                       FontWeight="ExtraBold"
                       TextWrapping="Wrap"
                       LineHeight="25"/>
            <TextBlock Text="{Binding Subtitle}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{StaticResource HmiFontSizeBody}"
                       TextWrapping="Wrap"
                       LineHeight="25"
                       Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource FactoryViewportFillPage}">
    <!-- The menu shows only what changes a decision: the engine truth chip, any
         ABNORMAL status as a chip (healthy and expected-absent states collapse into
         the one summary line), the grouped destination tiles, and the evidence
         boundary. Live inspection state lives on Run Inspection, hardware detail on
         Hardware Readiness. The page inset lives on the ScrollViewer Padding, never
         on this Grid: a Margin here adds to the scroll extent and re-creates the
         permanent sliver of scroll. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <WrapPanel Orientation="Horizontal">
          <Border x:Name="HomeEngineStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Engine" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeEngineStatusText" Text="Pixel Difference Prototype Engine" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeDatabaseStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="DB" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeDatabaseStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeImageVaultStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Vault" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeImageVaultStatusText" Text="Not Available" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeCameraStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Camera" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeCameraStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeLightingStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Light" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeLightingStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeRobotStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Robot" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeRobotStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeMesStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="MES" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeMesStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeEStopStatusBorder" Style="{StaticResource HmiAdaptiveStatusUnavailable}" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
              <TextBlock Text="E-Stop" Style="{StaticResource HmiAdaptiveStatusValueText}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeEStopStatusText" Text="Not Connected" Style="{StaticResource HmiAdaptiveStatusText}"/>
            </DockPanel>
          </Border>
        </WrapPanel>
        <TextBlock x:Name="HomeStatusSummaryText"
                   Text="Status summary loading..."
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="{StaticResource HmiFontSizeBody}"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0"
                   ToolTip="Healthy and Stage-1-expected states are summarized here; anything abnormal appears as a colored chip above. Full hardware detail: Hardware Readiness."/>
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Operate" Style="{StaticResource HomeGroupHeader}"/>
        <ItemsControl x:Name="HomeModuleItems" Grid.Row="1" ItemsSource="{Binding OperatePages}" ItemTemplate="{StaticResource HomeModuleTileTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Grid.Row="2" Text="Analyze &amp; Evidence" Style="{StaticResource HomeGroupHeader}" Margin="0,6,0,4"/>
        <ItemsControl x:Name="HomeAnalyzeItems" Grid.Row="3" ItemsSource="{Binding AnalyzePages}" ItemTemplate="{StaticResource HomeModuleTileTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Grid.Row="4" Text="Machine &amp; System" Style="{StaticResource HomeGroupHeader}" Margin="0,6,0,4"/>
        <ItemsControl x:Name="HomeSystemItems" Grid.Row="5" ItemsSource="{Binding SystemPages}" ItemTemplate="{StaticResource HomeModuleTileTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>

      <Border Grid.Row="4" Style="{StaticResource HmiPlainLanguageNote}" Padding="10">
        <TextBlock Text="Stage 1 image-validation evidence is for review. Camera, lighting, robot, safety, and MES readiness still require Hardware Readiness evidence before any real factory-integration claim."
                   Style="{StaticResource HmiPageSubtitleText}" TextWrapping="Wrap"/>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
