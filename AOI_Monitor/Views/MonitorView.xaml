<UserControl x:Class="AOI_Monitor.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}"
             PreviewKeyDown="OnMonitorPreviewKeyDown">
  <UserControl.Resources>
    <!-- Labels and values share the same top alignment and vertical margin so every
         Board/Status row reads from a common baseline even when the value wraps. -->
    <Style x:Key="MonitorStatusLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextLabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,10,4"/>
    </Style>
    <Style x:Key="MonitorStatusValue" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
    <Style x:Key="MonitorStatusWrappedValue" TargetType="TextBlock" BasedOn="{StaticResource HmiAdaptiveFieldWrappedValueText}">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource FactoryViewportFillPage}">
  <!-- Viewport-fill idiom: the page inset lives on the ScrollViewer Padding; the root Grid
       carries NO outer Margin so the star rows genuinely bound the image viewport, defect
       list, and alarm log instead of relying on hard MaxHeight caps. -->
  <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="4*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Main Inspection" Style="{StaticResource HmiSectionHeaderText}"/>
          <TextBlock Text="Load a board image, review the marked defects, then save the result. Purple panels mean the action is simulated or mock-only."
                     Style="{StaticResource HmiPageSubtitleText}" Margin="0,3,0,0"/>
          <TextBlock Text="Inspection stage indicators (read-only):"
                     Foreground="{DynamicResource HmiTextLabelBrush}"
                     FontSize="{StaticResource HmiFontSizeBody}"
                     Margin="0,8,0,3"/>
          <WrapPanel>
            <Border Style="{StaticResource HmiStatusInfo}" Margin="{StaticResource HmiChipGap}"
                    ToolTip="Status indicator, not a button. Fiducial alignment runs automatically inside golden compare; blue = informational stage.">
              <TextBlock Text="Fiducial alignment" Foreground="{DynamicResource HmiInfoSoftBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource HmiStatusInfo}" Margin="{StaticResource HmiChipGap}"
                    ToolTip="Status indicator, not a button. The golden reference image is selected in Board &amp; Images or Golden Compare; blue = informational stage.">
              <TextBlock Text="Golden template" Foreground="{DynamicResource HmiInfoSoftBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource HmiStatusInfo}" Margin="{StaticResource HmiChipGap}"
                    ToolTip="Status indicator, not a button. ROI masks come from the saved recipe (Recipe Rules); blue = informational stage.">
              <TextBlock Text="ROI masks" Foreground="{DynamicResource HmiInfoSoftBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource HmiStatusWarning}" Margin="{StaticResource HmiChipGap}"
                    ToolTip="Status indicator, not a button. Tolerance rules are configured in Recipe Rules; amber = review the configuration before trusting verdicts.">
              <TextBlock Text="Tolerance rules" Foreground="{DynamicResource HmiWarnSoftBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource HmiStatusWarning}" Margin="{StaticResource HmiChipGap}"
                    ToolTip="Status indicator, not a button. Lighting control is a Stage 2 hardware boundary; amber = not validated in Stage 1.">
              <TextBlock Text="Lighting boundary" Foreground="{DynamicResource HmiWarnSoftBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
          </WrapPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Disposition" Margin="{StaticResource HmiButtonGap}" Click="OnOpenDispositionClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Golden Compare" Margin="{StaticResource HmiButtonGap}" Click="OnOpenCompareClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Image Library" Click="OnOpenLibraryClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.85*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="0.95*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ImageStatusText" Text="No image loaded" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="OpenInspectionImageViewerButton"
                        Style="{StaticResource MiniBtn}"
                        Content="Large Image"
                        MinWidth="112"
                        Click="OnOpenImageViewerClick"/>
              </StackPanel>
              <TextBlock Text="Image / Simulated Live Feed" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </DockPanel>
          </Border>

          <WrapPanel Grid.Row="1" Margin="8">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource HmiButtonGap}">
              <TextBlock Text="View" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center" Margin="{StaticResource HmiButtonGap}"/>
              <ComboBox x:Name="ViewSelector" Width="110" SelectedIndex="0" AutomationProperties.Name="Inspection view" SelectionChanged="OnViewSelectionChanged">
                <ComboBoxItem Content="Top" Tag="Top"/>
                <ComboBoxItem Content="Side" Tag="Side"/>
                <ComboBoxItem Content="Bottom" Tag="Bottom"/>
              </ComboBox>
            </StackPanel>
            <CheckBox x:Name="OverlayCheck" Content="Defect overlay layer" IsChecked="True"
                      VerticalAlignment="Center" Foreground="{DynamicResource HmiTextBodyBrush}" Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"
                      Margin="{StaticResource HmiButtonGap}"/>
            <Button Style="{StaticResource MiniBtn}" Content="Top Folder" Margin="{StaticResource HmiButtonGap}" Click="OnSelectTopFolderClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Side Folder" Margin="{StaticResource HmiButtonGap}" Click="OnSelectSideFolderClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Bottom Folder" Margin="{StaticResource HmiButtonGap}" Click="OnSelectBottomFolderClick"/>
            <CheckBox x:Name="AutoSaveCheck" Content="Auto-save" Foreground="{DynamicResource HmiTextBodyBrush}" VerticalAlignment="Center" Margin="{StaticResource HmiButtonGap}"/>
          </WrapPanel>

          <UniformGrid Grid.Row="2" Columns="4" Margin="8,0,8,8">
            <Button x:Name="StartInspectionButton" Style="{StaticResource ActionBtnGreen}" Content="Start (F5)" Margin="{StaticResource HmiButtonGap}" Click="OnStartClick"/>
            <Button x:Name="StopInspectionButton" Style="{StaticResource ActionBtnRed}" Content="Stop (F6)" Margin="{StaticResource HmiButtonGap}" Click="OnStopClick"/>
            <Button x:Name="NextBoardButton" Style="{StaticResource ActionBtnBlue}" Content="Next Board (F7)" Margin="{StaticResource HmiButtonGap}" Click="OnNextBoardClick"/>
            <Button x:Name="SaveResultButton" Style="{StaticResource ActionBtnAmber}" Content="Save Result (Ctrl+S)" Click="OnSaveResultClick"/>
          </UniformGrid>

          <Border Grid.Row="3" Margin="8,0,8,8" Style="{StaticResource HmiStatusSimulated}" Padding="10" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Simulated Robot / Handler" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
                <TextBlock Text="Simulation only. No real robot, handler, PLC, or safety hardware is connected."
                           Foreground="#E5CAFF" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <WrapPanel Margin="0,5,0,0">
                  <TextBlock x:Name="RobotSimStatusText" Text="Ready: simulation only" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="RobotBoardStateText" Text="No simulated board loaded" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="RobotCycleModeText" Text="No real robot connected" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="RobotCycleTimeText" Text="Last cycle --" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
                </WrapPanel>
                <TextBlock x:Name="RobotAcceptanceStatusText" Text="Robot acceptance: not validated" Foreground="{DynamicResource HmiWarnBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="RobotFaultText" Text="Fault: none" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button x:Name="RobotLoadButton" Style="{StaticResource MiniBtn}" Content="Load" Margin="{StaticResource HmiButtonGap}" Click="OnRobotLoadClick" ToolTip="Simulated handler load step only."/>
                <Button x:Name="RobotInspectButton" Style="{StaticResource MiniBtn}" Content="Inspect" Margin="{StaticResource HmiButtonGap}" Click="OnRobotInspectClick" ToolTip="Simulated handler inspect step only."/>
                <Button x:Name="RobotUnloadButton" Style="{StaticResource MiniBtn}" Content="Unload" Margin="{StaticResource HmiButtonGap}" Click="OnRobotUnloadClick" ToolTip="Simulated handler unload step only."/>
                <Button x:Name="RobotCancelButton" Style="{StaticResource MiniBtn}" Content="Cancel" Margin="{StaticResource HmiButtonGap}" Click="OnRobotCancelClick"/>
                <Button x:Name="RobotResetButton" Style="{StaticResource MiniBtn}" Content="Reset" Margin="{StaticResource HmiButtonGap}" Click="OnRobotResetClick"/>
                <Button x:Name="RobotEmergencyStopButton" Style="{StaticResource MiniBtnRed}" Content="E-Stop Sim" Margin="{StaticResource HmiButtonGap}" Click="OnRobotEmergencyStopClick" ToolTip="Simulated emergency-stop behavior. This is not wired to real safety hardware."/>
                <Button x:Name="RunRobotCycleButton" Style="{StaticResource MiniBtn}" Content="Run Cycle" Margin="{StaticResource HmiButtonGap}" Click="OnRobotCycleClick"/>
                <Button x:Name="RunRobotAcceptanceButton" Style="{StaticResource MiniBtn}" Content="Run Robot Cell Acceptance Test" Margin="{StaticResource HmiButtonGap}" Click="OnRobotAcceptanceClick" ToolTip="Acceptance means evidence review against configured criteria; it does not certify production readiness by itself."/>
                <Button x:Name="ExportRobotAcceptanceButton" Style="{StaticResource MiniBtn}" Content="Export Report" Click="OnExportRobotAcceptanceClick"/>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- The star row plus the Uniform-stretch Viewbox bound this viewport, so no
               MaxHeight cap is needed; MinHeight keeps it usable on small windows. -->
          <Border x:Name="InspectionImageViewport" Grid.Row="4" Margin="8,0,8,8" MinHeight="320" Background="#050607" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
              <TextBlock x:Name="EmptyImageText" Text="Select a folder or load an image from Image Library, then press Start / Next Board."
                         Style="{StaticResource HmiEmptyStateText}"/>
              <Viewbox Stretch="Uniform">
                <Grid x:Name="ImageOverlayRoot" Width="1000" Height="700">
                  <Image x:Name="InspectionImage" Stretch="Uniform"/>
                  <Canvas x:Name="DefectOverlayCanvas" Width="1000" Height="700" IsHitTestVisible="False"/>
                </Grid>
              </Viewbox>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="32"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
              <TextBlock Text="Board / Status" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <Grid Grid.Row="1" Margin="8">
              <Grid.ColumnDefinitions>
                <!-- Auto + MinWidth lets long labels ('Board / Model', 'Learned Evidence',
                     '2D Cal Profile') sit on one line instead of wrapping at a fixed 110. -->
                <ColumnDefinition Width="Auto" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="68"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Station" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Column="1" x:Name="StationText" Text="AOI-LIB-01" Style="{StaticResource MonitorStatusValue}"/>
              <TextBlock Grid.Row="1" Text="Board / Model" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BoardModelText" Text="TBOX-MAIN" Style="{StaticResource MonitorStatusValue}"/>
              <TextBlock Grid.Row="2" Text="Lot ID" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LotText" Text="POC-LOT" Style="{StaticResource MonitorStatusValue}"/>
              <TextBlock Grid.Row="3" Text="Operator" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OperatorText" Text="Engineer01" Style="{StaticResource MonitorStatusValue}"/>
              <TextBlock Grid.Row="4" Text="Engine" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="EngineText" Text="Pixel Difference Prototype Engine" Style="{StaticResource MonitorStatusWrappedValue}"/>
              <TextBlock Grid.Row="5" Text="Model Version" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ModelVersionText" Text="PIXEL_DIFF_0.2" Style="{StaticResource MonitorStatusWrappedValue}"/>
              <TextBlock Grid.Row="6" Text="Learned Evidence" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LearnedModelEvidenceText" Text="Learned visual model: not active." Style="{StaticResource MonitorStatusWrappedValue}" Foreground="{DynamicResource HmiSimulatedBrush}"/>
              <TextBlock Grid.Row="7" Text="2D Cal Profile" Style="{StaticResource MonitorStatusLabel}"/>
              <ComboBox Grid.Row="7" Grid.Column="1" x:Name="CalibrationProfileCombo" MinHeight="34"
                        AutomationProperties.Name="2D calibration profile"
                        SelectionChanged="OnCalibrationProfileSelectionChanged"
                        ToolTip="2D calibration profile / Stage 2 preparation only. Approximate board-mm coordinates are not robot-ready.">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="8" Text="Camera" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="8" Grid.Column="1" x:Name="CameraSourceText" Text="Not Connected" Style="{StaticResource MonitorStatusWrappedValue}"/>
              <TextBlock Grid.Row="9" Text="Frame" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="9" Grid.Column="1" x:Name="CameraFrameMetadataText" Text="No frame" Style="{StaticResource MonitorStatusWrappedValue}" Foreground="{DynamicResource HmiTextLabelBrush}" FontWeight="Normal"/>
              <TextBlock Grid.Row="10" Text="Lighting" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="10" Grid.Column="1" x:Name="LightingSyncText" Text="Not Connected" Style="{StaticResource MonitorStatusWrappedValue}" Foreground="{DynamicResource HmiTextLabelBrush}" FontWeight="Normal"/>
              <TextBlock Grid.Row="11" Text="Timing" Style="{StaticResource MonitorStatusLabel}"/>
              <TextBlock Grid.Row="11" Grid.Column="1" x:Name="TimingText" Text="--" Style="{StaticResource MonitorStatusValue}"/>
              <TextBlock Grid.Row="12" Text="Result" Style="{StaticResource MonitorStatusLabel}"/>
              <!-- Verdict surface: code-behind swaps HmiVerdictBannerOk/Ng/Warn via FindResource. -->
              <Border Grid.Row="12" Grid.Column="1" x:Name="ResultStatusBorder" Style="{StaticResource HmiVerdictBannerWarn}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="ResultStatusText" Text="REVIEW" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeVerdict}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="32"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
              <TextBlock Text="Defect List" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </Border>
            <!-- Star row bounds the grid (viewport-fill root), so no MaxHeight cap. Review-
                 critical columns lead; text columns use star widths + MinWidth with the
                 shared trim-with-tooltip cell style so headers and cells stop clipping. -->
            <DataGrid Grid.Row="1"
                      x:Name="DefectGrid"
                      AutomationProperties.Name="Defect list"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      Style="{StaticResource HmiDenseTable}"
                      MinWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ToolTip="ROI means region of interest: the image area checked for a defect.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding No}" Width="58" MinWidth="58"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="1.4*" MinWidth="132" ElementStyle="{StaticResource HmiDataGridCellText}"/>
                <DataGridTextColumn Header="ROI" Binding="{Binding RoiId}" Width="*" MinWidth="96" ElementStyle="{StaticResource HmiDataGridCellText}"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="*" MinWidth="128" ElementStyle="{StaticResource HmiDataGridCellText}"/>
                <DataGridTextColumn Header="ROI Type" Binding="{Binding RoiType}" Width="*" MinWidth="120" ElementStyle="{StaticResource HmiDataGridCellText}"/>
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="84" MinWidth="84" ElementStyle="{StaticResource HmiDataGridCellText}"/>
                <DataGridTextColumn Header="X" Binding="{Binding XDisplay}" Width="72" MinWidth="72"/>
                <DataGridTextColumn Header="Y" Binding="{Binding YDisplay}" Width="72" MinWidth="72"/>
                <DataGridTextColumn Header="Board X" Binding="{Binding BoardXDisplay}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Board Y" Binding="{Binding BoardYDisplay}" Width="120" MinWidth="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="32"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <DockPanel>
            <TextBlock x:Name="ModeText" DockPanel.Dock="Right" Text="STOPPED" Foreground="{DynamicResource HmiWarnBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            <TextBlock Text="Alarm / Event Log" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          </DockPanel>
        </Border>
        <!-- Star row (viewport-fill root) bounds the log height; no MaxHeight cap needed. -->
        <DataGrid Grid.Row="1" x:Name="AlarmGrid" AutomationProperties.Name="Alarm and event log" AutoGenerateColumns="False" Style="{StaticResource HmiTable}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="96" MinWidth="96"/>
            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="150" MinWidth="150"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="900" ElementStyle="{StaticResource HmiDataGridCellText}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>

