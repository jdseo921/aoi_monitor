<UserControl x:Class="AOI_Monitor.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <ScrollViewer Style="{StaticResource FactoryViewportFillPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Fill the viewport: the runtime-notes table absorbs spare height (audit
         TrailingVoidPercent was 53.8% at 1080p before this). Page inset lives on the
         ScrollViewer Padding (FactoryViewportFillPage); the root Grid carries no Margin. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Runtime table -->
      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
            <TextBlock Text="Prototype Runtime Notes" Style="{StaticResource HmiSectionHeaderText}"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="RuntimeGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Runtime Element" Binding="{Binding Element}"  Width="180"/>
              <DataGridTextColumn Header="Status"          Binding="{Binding Status}"   Width="70"/>
              <DataGridTextColumn Header="Purpose"         Binding="{Binding Purpose}"  Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Height" Value="40"/>
              </Style>
            </DataGrid.RowStyle>
          </DataGrid>
        </Grid>
      </Border>

      <!-- GUI role -->
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
            <TextBlock Text="GUI Role" Style="{StaticResource HmiSectionHeaderText}"/>
          </Border>
          <UniformGrid Grid.Row="1" Columns="1" Margin="8" Rows="4">
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Current Runtime"       Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock Text="Local WPF App"        FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Visible GUI"         Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock Text="Review Console"   FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Default Module"        Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock Text="Main Inspection"            FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Stage 2+"  Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/><TextBlock Text="Hardware/MES planned"     FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/></StackPanel></Border>
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Installation boundary -->
    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
          <TextBlock Text="Documentation Boundary" Style="{StaticResource HmiSectionHeaderText}"/>
        </Border>
        <!-- No MaxHeight: the table renders its four static rows in full instead of
             nesting a second scrollbar inside the page ScrollViewer. -->
        <DataGrid Grid.Row="1" x:Name="BoundaryGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Topic"       Binding="{Binding Topic}"   Width="175"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Desc}"    Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Bottom note -->
    <Border Grid.Row="2" Background="#14080A" BorderBrush="#4B2325" BorderThickness="1" Padding="7,10">
      <TextBlock Text="Prototype note: this app runs local file-based review only; service deployment and hardware integration are planned."
                 Foreground="{DynamicResource HmiNgBrush}" FontWeight="ExtraBold" TextAlignment="Center" FontSize="{StaticResource HmiFontSizeBody}"/>
    </Border>
    </Grid>
  </ScrollViewer>
</UserControl>

