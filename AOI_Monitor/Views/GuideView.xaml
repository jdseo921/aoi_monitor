<UserControl x:Class="AOI_Monitor.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <!-- Explicit scroll attributes restate the FactoryViewportFillPage style values; a
       repo-content test asserts these literals on documentation pages. -->
  <ScrollViewer Style="{StaticResource FactoryViewportFillPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Viewport-fill idiom: the page inset lives on the ScrollViewer Padding, never on this
         Grid. The review-sequence table is the star element and absorbs spare height (audit
         TrailingVoidPercent was 57.9% at 1080p before this). -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header + navigation actions (above the fold) -->
      <Border Style="{StaticResource Panel}" Margin="{StaticResource HmiRowGap}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
            <TextBlock Text="Settings / Guide"
                       Style="{StaticResource HmiSectionHeaderText}"
                       ToolTip="Operator workflow reference with access to local settings and prototype installation notes."/>
          </Border>
          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="8,8,0,0">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Open Settings" Margin="{StaticResource HmiFieldGap}" Click="OnOpenSettingsClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Calibration" Margin="{StaticResource HmiFieldGap}" Click="OnOpenCalibrationClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Installation Notes" Margin="{StaticResource HmiFieldGap}" Click="OnOpenInstallClick"/>
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Steps: the guide content, star-sized to fill the viewport -->
      <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="{StaticResource HmiRowGap}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource HmiPanelHeader}">
            <TextBlock Text="Mandatory Review Sequence" Style="{StaticResource HmiSectionHeaderText}"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="StepsGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#"           Binding="{Binding Num}"      Width="38"/>
              <DataGridTextColumn Header="Step"        Binding="{Binding Step}"     Width="*" ElementStyle="{StaticResource HmiDataGridCellText}"/>
              <DataGridTextColumn Header="Priority"    Binding="{Binding Priority}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Review policy reference facts (self-labeled; boundary wording kept verbatim) -->
      <Border Grid.Row="2" Style="{StaticResource Panel}">
        <UniformGrid Columns="3" Rows="1" Margin="8">
          <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel>
              <TextBlock Text="Default Policy" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Minimize False Positives" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel>
              <TextBlock Text="Primary Evidence" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Image + ROI + GT + Inspection Result" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="Commissioning Mode" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Local DB / No MES Writeback" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
