  <Style x:Key="HmiScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid x:Name="VerticalTrack">
              <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
              </Grid.RowDefinitions>
              <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Style="{StaticResource HmiScrollBarButton}"/>
              <primitives:Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <primitives:Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource HmiScrollBarButton}"/>
                </primitives:Track.DecreaseRepeatButton>
                <primitives:Track.Thumb>
                  <primitives:Thumb Style="{StaticResource HmiScrollBarThumb}"/>
                </primitives:Track.Thumb>
                <primitives:Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource HmiScrollBarButton}"/>
                </primitives:Track.IncreaseRepeatButton>
              </primitives:Track>
              <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Style="{StaticResource HmiScrollBarButton}"/>
            </Grid>
            <Grid x:Name="HorizontalTrack" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
              </Grid.ColumnDefinitions>
              <RepeatButton Grid.Column="0" Command="{x:Static ScrollBar.LineLeftCommand}" Style="{StaticResource HmiScrollBarButton}"/>
              <primitives:Track Grid.Column="1">
                <primitives:Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource HmiScrollBarButton}"/>
                </primitives:Track.DecreaseRepeatButton>
                <primitives:Track.Thumb>
                  <primitives:Thumb Style="{StaticResource HmiScrollBarThumb}"/>
                </primitives:Track.Thumb>
                <primitives:Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource HmiScrollBarButton}"/>
                </primitives:Track.IncreaseRepeatButton>
              </primitives:Track>
              <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}" Style="{StaticResource HmiScrollBarButton}"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="Height" Value="16"/>
              <Setter Property="MinHeight" Value="16"/>
              <Setter TargetName="VerticalTrack" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="HorizontalTrack" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HmiScrollBar}"/>

  <Style TargetType="CheckBox">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CheckBorder"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HmiSurfaceBrush}"
                    BorderBrush="{DynamicResource HmiBorderBrush}"
                    BorderThickness="1"/>
            <Path x:Name="CheckMark"
                  Grid.Column="0"
                  Data="M 3 8 L 7 12 L 15 3"
                  Stroke="{DynamicResource HmiOkBrush}"
                  StrokeThickness="2.4"
                  StrokeEndLineCap="Square"
                  StrokeStartLineCap="Square"
                  Visibility="Collapsed"/>
            <ContentPresenter Grid.Column="1"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource HmiOkBrush}"/>
              <Setter TargetName="CheckBorder" Property="Background" Value="#123B20"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource HmiInfoBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource HmiMutedTextBrush}"/>
              <Setter TargetName="CheckBorder" Property="Opacity" Value="0.65"/>
              <Setter TargetName="CheckMark" Property="Opacity" Value="0.65"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="165"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style TargetType="{x:Type primitives:DatePickerTextBox}">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
</ResourceDictionary>
