<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:AOI_Monitor.Controls">

  <!-- Industrial HMI design tokens. Keep these self-contained: this dictionary is
       merged before App.xaml's legacy styles. -->
  <Color x:Key="HmiBgColor">#0B0E10</Color>
  <Color x:Key="HmiSurfaceColor">#151A1E</Color>
  <Color x:Key="HmiSurfaceAltColor">#1B2024</Color>
  <Color x:Key="HmiBorderColor">#3E474E</Color>
  <Color x:Key="HmiTextColor">#E8EEF2</Color>
  <Color x:Key="HmiMutedTextColor">#A8B2B9</Color>
  <Color x:Key="HmiOkColor">#50F56E</Color>
  <Color x:Key="HmiNgColor">#F27777</Color>
  <Color x:Key="HmiWarnColor">#E1A334</Color>
  <Color x:Key="HmiInfoColor">#5CA0D3</Color>
  <Color x:Key="HmiOfflineColor">#8B969E</Color>
  <Color x:Key="HmiSimulatedColor">#C084FC</Color>

  <SolidColorBrush x:Key="HmiBgBrush" Color="{StaticResource HmiBgColor}"/>
  <SolidColorBrush x:Key="HmiSurfaceBrush" Color="{StaticResource HmiSurfaceColor}"/>
  <SolidColorBrush x:Key="HmiSurfaceAltBrush" Color="{StaticResource HmiSurfaceAltColor}"/>
  <SolidColorBrush x:Key="HmiBorderBrush" Color="{StaticResource HmiBorderColor}"/>
  <SolidColorBrush x:Key="HmiTextBrush" Color="{StaticResource HmiTextColor}"/>
  <SolidColorBrush x:Key="HmiMutedTextBrush" Color="{StaticResource HmiMutedTextColor}"/>
  <SolidColorBrush x:Key="HmiOkBrush" Color="{StaticResource HmiOkColor}"/>
  <SolidColorBrush x:Key="HmiNgBrush" Color="{StaticResource HmiNgColor}"/>
  <SolidColorBrush x:Key="HmiWarnBrush" Color="{StaticResource HmiWarnColor}"/>
  <SolidColorBrush x:Key="HmiInfoBrush" Color="{StaticResource HmiInfoColor}"/>
  <SolidColorBrush x:Key="HmiOfflineBrush" Color="{StaticResource HmiOfflineColor}"/>
  <SolidColorBrush x:Key="HmiSimulatedBrush" Color="{StaticResource HmiSimulatedColor}"/>

  <!-- Extended neutral ramp + strong-NG tokens. Introduced when the ~770 per-view literal
       colors were consolidated onto these tokens; values are the exact literals they replaced,
       so the app renders as before. Services/HmiThemePalette.cs mirrors this table and
       HmiThemePaletteTests machine-checks both the WCAG contrast contract and palette/XAML
       agreement. Industrial Dark is the single supported theme. -->
  <Color x:Key="HmiTextBodyColor">#DCE5EB</Color>
  <Color x:Key="HmiTextLabelColor">#9AA6AF</Color>
  <Color x:Key="HmiTextDimColor">#7F8C95</Color>
  <Color x:Key="HmiNgStrongColor">#F13B3F</Color>
  <Color x:Key="HmiRaisedColor">#20272B</Color>
  <Color x:Key="HmiPanelBorderColor">#343D44</Color>
  <Color x:Key="HmiBorderMidColor">#59636B</Color>
  <Color x:Key="HmiBorderStrongColor">#8C9BA4</Color>

  <SolidColorBrush x:Key="HmiTextBodyBrush" Color="{StaticResource HmiTextBodyColor}"/>
  <SolidColorBrush x:Key="HmiTextLabelBrush" Color="{StaticResource HmiTextLabelColor}"/>
  <SolidColorBrush x:Key="HmiTextDimBrush" Color="{StaticResource HmiTextDimColor}"/>
  <SolidColorBrush x:Key="HmiNgStrongBrush" Color="{StaticResource HmiNgStrongColor}"/>
  <SolidColorBrush x:Key="HmiRaisedBrush" Color="{StaticResource HmiRaisedColor}"/>
  <SolidColorBrush x:Key="HmiPanelBorderBrush" Color="{StaticResource HmiPanelBorderColor}"/>
  <SolidColorBrush x:Key="HmiBorderMidBrush" Color="{StaticResource HmiBorderMidColor}"/>
  <SolidColorBrush x:Key="HmiBorderStrongBrush" Color="{StaticResource HmiBorderStrongColor}"/>

  <!-- Soft status text (pale tint used on themed surfaces; chip-internal text keeps its
       literal pair) and the table selection tint. -->
  <Color x:Key="HmiInsetPanelColor">#13191D</Color>
  <Color x:Key="HmiDeepInsetColor">#080A0C</Color>
  <Color x:Key="HmiWarnSoftColor">#FFE0A7</Color>
  <Color x:Key="HmiNgSoftColor">#FFCDD0</Color>
  <Color x:Key="HmiOkSoftColor">#C6FFD0</Color>
  <Color x:Key="HmiInfoSoftColor">#CFEAFF</Color>
  <Color x:Key="HmiSimulatedSoftColor">#F1D8FF</Color>
  <Color x:Key="HmiSelectionColor">#273642</Color>

  <SolidColorBrush x:Key="HmiInsetPanelBrush" Color="{StaticResource HmiInsetPanelColor}"/>
  <SolidColorBrush x:Key="HmiDeepInsetBrush" Color="{StaticResource HmiDeepInsetColor}"/>
  <SolidColorBrush x:Key="HmiWarnSoftBrush" Color="{StaticResource HmiWarnSoftColor}"/>
  <SolidColorBrush x:Key="HmiNgSoftBrush" Color="{StaticResource HmiNgSoftColor}"/>
  <SolidColorBrush x:Key="HmiOkSoftBrush" Color="{StaticResource HmiOkSoftColor}"/>
  <SolidColorBrush x:Key="HmiInfoSoftBrush" Color="{StaticResource HmiInfoSoftColor}"/>
  <SolidColorBrush x:Key="HmiSimulatedSoftBrush" Color="{StaticResource HmiSimulatedSoftColor}"/>
  <SolidColorBrush x:Key="HmiSelectionBrush" Color="{StaticResource HmiSelectionColor}"/>

  <!-- Shell chrome: brand top bar, footer strip, and flyout/overlay panels. -->
  <Color x:Key="HmiChromeColor">#0D2438</Color>
  <Color x:Key="HmiChromeAltColor">#081018</Color>
  <Color x:Key="HmiFlyoutColor">#0C0F11</Color>
  <Color x:Key="HmiFlyoutAltColor">#0F151A</Color>
  <Color x:Key="HmiFlyoutBorderColor">#3A4249</Color>
  <SolidColorBrush x:Key="HmiChromeBrush" Color="{StaticResource HmiChromeColor}"/>
  <SolidColorBrush x:Key="HmiChromeAltBrush" Color="{StaticResource HmiChromeAltColor}"/>
  <SolidColorBrush x:Key="HmiFlyoutBrush" Color="{StaticResource HmiFlyoutColor}"/>
  <SolidColorBrush x:Key="HmiFlyoutAltBrush" Color="{StaticResource HmiFlyoutAltColor}"/>
  <SolidColorBrush x:Key="HmiFlyoutBorderBrush" Color="{StaticResource HmiFlyoutBorderColor}"/>
  <SolidColorBrush x:Key="HmiScrimBrush" Color="#EE151A1E"/>
  <SolidColorBrush x:Key="HmiLoadingScrimBrush" Color="#CC050607"/>
  <SolidColorBrush x:Key="HmiNoteBrush" Color="#172A39"/>
  <SolidColorBrush x:Key="HmiNoteBorderBrush" Color="#477CA5"/>

  <!-- Typography floor: the customer spec requires operator text >= 14 pt. 14 pt = 18.67 DIP
       at 96 DPI, and the HMI layout audit fails below 18.6667 (MinimumReadableFontDip). Raised
       from 14 DIP (10.5 pt) on 2026-08-23; deviation DEV-05 is thereby closed, not signed off. -->
  <sys:Double x:Key="HmiFontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">18.67</sys:Double>
  <sys:Double x:Key="HmiFontSizeLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">18.67</sys:Double>
  <sys:Double x:Key="HmiFontSizeSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">18.67</sys:Double>
  <sys:Double x:Key="HmiFontSizeSection" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
  <sys:Double x:Key="HmiFontSizePageTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
  <sys:Double x:Key="HmiButtonMinHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>
  <sys:Double x:Key="HmiButtonMinWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">120</sys:Double>
  <Thickness x:Key="HmiCardPadding">12</Thickness>
  <Thickness x:Key="HmiPanelGap">8</Thickness>

  <!-- Spacing scale. Use these tokens instead of ad-hoc pixel margins so gaps stay
       consistent across every screen: XS=4, S=8, M=12, L=16, XL=24.
       *Space* doubles feed StackPanel.Spacing / gaps; *Gap* thicknesses feed Margins. -->
  <sys:Double x:Key="HmiSpaceXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
  <sys:Double x:Key="HmiSpaceS" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
  <sys:Double x:Key="HmiSpaceM" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
  <sys:Double x:Key="HmiSpaceL" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
  <sys:Double x:Key="HmiSpaceXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
  <Thickness x:Key="HmiPageMargin">16</Thickness>
  <Thickness x:Key="HmiRowGap">0,0,0,8</Thickness>
  <Thickness x:Key="HmiFieldGap">0,0,8,8</Thickness>
  <Thickness x:Key="HmiButtonGap">0,0,8,0</Thickness>
  <Thickness x:Key="HmiChipGap">0,0,6,6</Thickness>
  <Thickness x:Key="HmiSectionGap">0,0,0,16</Thickness>

  <Style x:Key="FactoryPageContainer" TargetType="Grid">
    <Setter Property="Margin" Value="10"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style x:Key="FactoryScrollablePage" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="CanContentScroll" Value="False"/>
    <Setter Property="PanningMode" Value="VerticalOnly"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource HmiBgBrush}"/>
  </Style>

  <!-- Viewport-filling page idiom: the page inset lives on the ScrollViewer as Padding
       (ViewportHeight excludes Padding), and the child root Grid carries NO outer Margin —
       a Margin outside a ViewportHeight-bound MinHeight adds itself to the scroll extent
       and guarantees a permanent sliver of scroll even when everything fits. -->
  <Style x:Key="FactoryViewportFillPage" TargetType="ScrollViewer" BasedOn="{StaticResource FactoryScrollablePage}">
    <Setter Property="Padding" Value="8"/>
  </Style>

  <!-- One shared panel-header strip: replaces the per-view hand-rolled header Borders so
       every panel titles at the same size, padding, and rule weight. -->
  <Style x:Key="HmiPanelHeader" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceAltBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Read-only detail pane for wide evidence tables: identity/status columns stay in the
       DataGrid; long free-text fields (steps, expected/actual behavior, evidence paths,
       notes) read here for the selected row instead of forcing horizontal grid scroll. -->
  <Style x:Key="HmiDetailFieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextLabelBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
  </Style>

  <Style x:Key="HmiDetailFieldValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- Empty-state overlay text for tables/canvases: one voice for "nothing here yet". -->
  <Style x:Key="HmiEmptyStateText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextDimBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="16"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- Verdict banner family: the one style for large OK / REVIEW / NG verdict surfaces.
       Backgrounds/borders mirror the adaptive status chip states; code-behind swaps the
       style per verdict instead of assigning raw hex brushes. -->
  <sys:Double x:Key="HmiFontSizeVerdict" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
  <sys:Double x:Key="HmiFontSizeDisplay" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
  <Style x:Key="HmiVerdictBanner" TargetType="Border">
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Background" Value="#20262B"/>
    <Setter Property="BorderBrush" Value="#667078"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="HmiVerdictBannerOk" TargetType="Border" BasedOn="{StaticResource HmiVerdictBanner}">
    <Setter Property="Background" Value="#14311D"/>
    <Setter Property="BorderBrush" Value="#3C8D50"/>
  </Style>
  <Style x:Key="HmiVerdictBannerNg" TargetType="Border" BasedOn="{StaticResource HmiVerdictBanner}">
    <Setter Property="Background" Value="#35191B"/>
    <Setter Property="BorderBrush" Value="#A13A3F"/>
  </Style>
  <Style x:Key="HmiVerdictBannerWarn" TargetType="Border" BasedOn="{StaticResource HmiVerdictBanner}">
    <Setter Property="Background" Value="#372914"/>
    <Setter Property="BorderBrush" Value="#987538"/>
  </Style>

  <Style x:Key="FactoryCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="FactoryFormFieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiMutedTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeLabel}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HmiAdaptiveFilterBand" TargetType="WrapPanel">
    <Setter Property="Margin" Value="8"/>
    <Setter Property="Orientation" Value="Horizontal"/>
  </Style>

  <Style x:Key="HmiAdaptiveFilterField" TargetType="StackPanel">
    <Setter Property="Width" Value="238"/>
    <Setter Property="MinWidth" Value="210"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>

  <Style x:Key="HmiAdaptiveFilterActionBand" TargetType="WrapPanel">
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Orientation" Value="Horizontal"/>
  </Style>

  <Style x:Key="HmiDarkContentSurface" TargetType="Border" BasedOn="{StaticResource FactoryCard}">
    <Setter Property="Background" Value="{DynamicResource HmiBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style x:Key="FactoryWrappedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="None"/>
    <Setter Property="LineHeight" Value="25"/>
  </Style>

  <Style x:Key="FactoryTrimmedTextWithTooltip" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style x:Key="HmiAdaptiveStatusChip" TargetType="Border" BasedOn="{StaticResource FactoryCard}">
    <Setter Property="MinWidth" Value="92"/>
    <Setter Property="MaxWidth" Value="320"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="LineHeight" Value="25"/>
      </Style>
    </Style.Resources>
  </Style>

  <Style x:Key="HmiAdaptiveStatusText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="None"/>
    <Setter Property="LineHeight" Value="25"/>
  </Style>

  <Style x:Key="HmiAdaptiveStatusValueText" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
    <Setter Property="Foreground" Value="{DynamicResource HmiMutedTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MaxWidth" Value="240"/>
  </Style>

  <Style x:Key="HmiAdaptiveStatusOk" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#14311D"/>
    <Setter Property="BorderBrush" Value="#3C8D50"/>
  </Style>
  <Style x:Key="HmiAdaptiveStatusNg" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#35191B"/>
    <Setter Property="BorderBrush" Value="#A13A3F"/>
  </Style>
  <Style x:Key="HmiAdaptiveStatusWarning" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#372914"/>
    <Setter Property="BorderBrush" Value="#987538"/>
  </Style>
  <Style x:Key="HmiAdaptiveStatusInfo" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#172A39"/>
    <Setter Property="BorderBrush" Value="#477CA5"/>
  </Style>
  <Style x:Key="HmiAdaptiveStatusSimulated" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#2A1740"/>
    <Setter Property="BorderBrush" Value="#8F5FD1"/>
  </Style>
  <Style x:Key="HmiAdaptiveStatusUnavailable" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="Background" Value="#20262B"/>
    <Setter Property="BorderBrush" Value="#667078"/>
  </Style>

  <Style x:Key="HmiBoundaryEvidenceBadge" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="MinWidth" Value="112"/>
    <Setter Property="MaxWidth" Value="280"/>
  </Style>
  <Style x:Key="HmiEvidenceRealHardware" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusOk}"/>
  <Style x:Key="HmiEvidencePilot" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusInfo}"/>
  <Style x:Key="HmiEvidenceBoundaryOnly" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusWarning}"/>
  <Style x:Key="HmiEvidenceSimulated" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusSimulated}"/>
  <Style x:Key="HmiEvidenceMock" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusSimulated}"/>
  <Style x:Key="HmiEvidenceDemo" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusSimulated}"/>
  <Style x:Key="HmiEvidenceSampleData" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusWarning}"/>
  <Style x:Key="HmiEvidenceNotConnected" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusUnavailable}"/>
  <Style x:Key="HmiEvidenceNotValidated" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusWarning}"/>

  <Style x:Key="HmiAdaptiveSectionHeader" TargetType="Border" BasedOn="{StaticResource FactoryCard}">
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Background" Value="#172027"/>
  </Style>

  <Style x:Key="HmiAdaptiveSectionHeaderTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeSection}"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="None"/>
    <Setter Property="LineHeight" Value="25"/>
  </Style>

  <Style x:Key="HmiAdaptiveSectionHeaderBadge" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusChip}">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="MaxWidth" Value="220"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HmiAdaptiveFieldRow" TargetType="Grid">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="HmiAdaptiveFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FactoryFormFieldLabel}">
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="HmiAdaptiveFieldValueText" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HmiAdaptiveFieldWrappedValueText" TargetType="TextBlock" BasedOn="{StaticResource FactoryWrappedText}">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style x:Key="HmiFieldTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource HmiInfoBrush}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="160"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style x:Key="HmiFieldComboBox" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="160"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="MaxDropDownHeight" Value="360"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=SelectionBoxItem}"/>
  </Style>

  <Style x:Key="HmiFieldDatePicker" TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="165"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style x:Key="HmiFieldPasswordBox" TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HmiBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource HmiInfoBrush}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="160"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HmiShellTrimmedText" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
    <Setter Property="Foreground" Value="{DynamicResource HmiTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HmiShellBadgeText" TargetType="TextBlock" BasedOn="{StaticResource HmiShellTrimmedText}">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="MaxWidth" Value="260"/>
  </Style>

  <Style x:Key="HmiShellValueChip" TargetType="Border" BasedOn="{StaticResource FactoryCard}">
    <Setter Property="MinWidth" Value="118"/>
    <Setter Property="MaxWidth" Value="260"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,4"/>
