<Application x:Class="AOI_Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/FactoryHmiLayout.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Bg"        Color="#0B0E10"/>
    <SolidColorBrush x:Key="WindowBg"  Color="#121619"/>
    <SolidColorBrush x:Key="FrameBg"   Color="#252C31"/>
    <SolidColorBrush x:Key="Frame2Bg"  Color="#1B2024"/>
    <SolidColorBrush x:Key="CellBg"    Color="#151A1E"/>
    <SolidColorBrush x:Key="Cell2Bg"   Color="#1C2328"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3D464D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D8DEE3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B969E"/>
    <SolidColorBrush x:Key="DimBrush" Color="#667078"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource HmiOkColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource HmiNgColor}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource HmiWarnColor}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource HmiInfoColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource HmiSimulatedColor}"/>

    <!-- Fonts -->
    <FontFamily x:Key="HmiFontFamily">Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Malgun Gothic</FontFamily>

    <!-- Base text -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"   Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
      <Setter Property="Background"    Value="{DynamicResource Frame2Bg}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding"       Value="12,6"/>
      <Setter Property="MinHeight"     Value="36"/>
      <Setter Property="MinWidth"      Value="96"/>
      <Setter Property="FontFamily"    Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"      Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="Cursor"        Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="TextTrimming" Value="None"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cell2Bg}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource FrameBg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Mini buttons -->
    <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style x:Key="MiniBtnGreen" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#3C7F4D"/><Setter Property="Background" Value="#14351D"/><Setter Property="Foreground" Value="#C1FFCB"/>
    </Style>
    <Style x:Key="MiniBtnAmber" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#806434"/><Setter Property="Background" Value="#332715"/><Setter Property="Foreground" Value="#FFE0A4"/>
    </Style>
    <Style x:Key="MiniBtnRed" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#854041"/><Setter Property="Background" Value="#351719"/><Setter Property="Foreground" Value="#FFBCBC"/>
    </Style>

    <!-- Action buttons -->
    <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="120"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="BorderBrush" Value="#5A646D"/><Setter Property="Background" Value="#222A30"/><Setter Property="Foreground" Value="#E8EEF2"/>
    </Style>
    <Style x:Key="ActionBtnGreen" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#3C8D50"/><Setter Property="Background" Value="#17391F"/><Setter Property="Foreground" Value="#D1FFD8"/>
    </Style>
    <Style x:Key="ActionBtnRed" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#A13A3F"/><Setter Property="Background" Value="#4A171A"/><Setter Property="Foreground" Value="#FFD0D2"/>
    </Style>
    <Style x:Key="ActionBtnAmber" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#987538"/><Setter Property="Background" Value="#3F2C13"/><Setter Property="Foreground" Value="#FFE3AD"/>
    </Style>
    <Style x:Key="ActionBtnBlue" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#4B87B4"/><Setter Property="Background" Value="#173047"/><Setter Property="Foreground" Value="#CFEAFF"/>
    </Style>
    <Style x:Key="ActionBtnPurple" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#8F5FD1"/><Setter Property="Background" Value="#2A1740"/><Setter Property="Foreground" Value="#F1D8FF"/>
    </Style>

    <!-- Nav button -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background"    Value="#171D21"/>
      <Setter Property="BorderBrush"   Value="#374047"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="#C9D1D6"/>
      <Setter Property="MinHeight"     Value="40"/>
      <Setter Property="Margin"        Value="0,0,0,4"/>
      <Setter Property="Padding"       Value="0"/>
      <Setter Property="Cursor"        Value="Hand"/>
      <Setter Property="FontFamily"    Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"      Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cell2Bg}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text boxes -->
    <Style TargetType="TextBox">
      <Setter Property="Background"    Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="#5CA0D3"/>
      <Setter Property="MinHeight"     Value="34"/>
      <Setter Property="Padding"       Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily"    Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"      Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="ToolTip"       Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBoxBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TextBoxBorder" Property="Background" Value="{DynamicResource Frame2Bg}"/>
                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReadonlyInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Foreground"  Value="#99A4AB"/>
      <Setter Property="Background"  Value="{DynamicResource Frame2Bg}"/>
      <Setter Property="IsReadOnly"  Value="True"/>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Background"    Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="#5CA0D3"/>
      <Setter Property="MinHeight"     Value="36"/>
      <Setter Property="Padding"       Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily"    Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"      Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="PasswordBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PasswordBorder" Property="Background" Value="{DynamicResource Frame2Bg}"/>
                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Combo boxes -->
    <Style TargetType="ComboBox">
      <Style.Resources>
        <!-- The app-wide implicit TextBlock style wraps text; a combo's selection box must
             never wrap (it clips vertically at the 14 pt floor). Trim with a tooltip-free
             ellipsis instead - combos carry their own dropdown for the full value. -->
        <Style TargetType="TextBlock">
          <Setter Property="TextWrapping" Value="NoWrap"/>
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
      </Style.Resources>
      <Setter Property="Background"    Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
      <Setter Property="MinHeight"     Value="34"/>
      <Setter Property="Padding"       Value="8,5"/>
      <Setter Property="FontFamily"    Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"      Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="MaxDropDownHeight" Value="360"/>
      <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=SelectionBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1,0,0,0">
                          <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                Fill="{DynamicResource TextBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Cell2Bg}"/>
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                IsHitTestVisible="False"
                                Margin="10,0,38,0"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{DynamicResource TextBrush}"
                                VerticalAlignment="Center"/>

              <TextBox x:Name="PART_EditableTextBox"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                       IsReadOnly="{TemplateBinding IsReadOnly}"
                       Margin="10,0,38,0"
                       Padding="0"
                       VerticalContentAlignment="Center"
                       Visibility="Hidden"/>

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="None">
                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Background="{DynamicResource CellBg}"
                          BorderBrush="{DynamicResource BlueBrush}"
                          BorderThickness="1">
                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  SnapsToDevicePixels="True"
                                  CanContentScroll="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource CellBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#214A63"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#2C5C7A"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Background" Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Data grids -->
    <Style TargetType="DataGrid">
      <Setter Property="Background"              Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush"             Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness"         Value="1"/>
      <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily"              Value="{DynamicResource HmiFontFamily}"/>
      <Setter Property="FontSize"                Value="{StaticResource HmiFontSizeBody}"/>
      <Setter Property="RowBackground"           Value="{DynamicResource CellBg}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Cell2Bg}"/>
      <Setter Property="GridLinesVisibility"     Value="All"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HmiPanelBorderBrush}"/>
      <Setter Property="VerticalGridLinesBrush"  Value="{DynamicResource HmiPanelBorderBrush}"/>
      <Setter Property="HeadersVisibility"       Value="Column"/>
      <Setter Property="AutoGenerateColumns"     Value="False"/>
      <Setter Property="CanUserAddRows"          Value="False"/>
      <Setter Property="CanUserDeleteRows"       Value="False"/>
      <Setter Property="CanUserReorderColumns"   Value="False"/>
      <Setter Property="IsReadOnly"              Value="True"/>
      <Setter Property="SelectionMode"           Value="Single"/>
      <Setter Property="MinColumnWidth"          Value="84"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="EnableColumnVirtualization" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HmiDataGridColumnHeader}"/>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource HmiSelectionBrush}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Cell2Bg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource HmiDataGridCell}"/>

    <!-- Progress bars -->
    <Style x:Key="BarTrack" TargetType="ProgressBar">
      <Setter Property="Height"     Value="8"/>
      <Setter Property="Foreground" Value="#7896C0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarTrackRed" TargetType="ProgressBar" BasedOn="{StaticResource BarTrack}">
      <Setter Property="Foreground" Value="#C34141"/>
    </Style>
    <Style x:Key="BarTrackAmber" TargetType="ProgressBar" BasedOn="{StaticResource BarTrack}">
      <Setter Property="Foreground" Value="#C58B31"/>
    </Style>

    <!-- Scroll bars -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HmiScrollBar}">
      <Setter Property="Background" Value="{DynamicResource HmiSurfaceBrush}"/>
    </Style>

    <!-- Status chips -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background"    Value="{DynamicResource HmiRaisedBrush}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource HmiBorderMidBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"       Value="6,2"/>
    </Style>
    <Style x:Key="ChipRed" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#35191B"/><Setter Property="BorderBrush" Value="#9A393E"/>
    </Style>
    <Style x:Key="ChipGreen" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#14311D"/><Setter Property="BorderBrush" Value="#377849"/>
    </Style>
    <Style x:Key="ChipAmber" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#372914"/><Setter Property="BorderBrush" Value="#8C6C35"/>
    </Style>
    <Style x:Key="ChipBlue" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#172A39"/><Setter Property="BorderBrush" Value="#477CA5"/>
    </Style>
    <Style x:Key="ChipPurple" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#2A1740"/><Setter Property="BorderBrush" Value="#8F5FD1"/>
    </Style>

    <!-- Field boxes -->
    <Style x:Key="FieldBox" TargetType="Border">
      <Setter Property="Background"    Value="{DynamicResource HmiSurfaceBrush}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource HmiPanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"       Value="6"/>
    </Style>

    <!-- Panels -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background"    Value="{DynamicResource HmiSurfaceBrush}"/>
      <Setter Property="BorderBrush"   Value="{DynamicResource HmiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
