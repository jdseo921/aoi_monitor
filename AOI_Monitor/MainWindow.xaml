<Window x:Class="AOI_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AOI_Monitor.ViewModels"
        Title="PCBA AOI Review Console"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowState="Maximized"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Border x:Name="ShellRootBorder" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="{DynamicResource HmiChromeBrush}" MinHeight="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#2B4658" BorderThickness="0,0,1,0">
            <TextBlock Text="{Binding ClockText}"
                       FontFamily="Consolas"
                       FontSize="{StaticResource HmiFontSizeSection}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource HmiTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <Button x:Name="HomeNavBtn"
                  Grid.Column="1"
                  Style="{StaticResource ActionBtnBlue}"
                  Content="Home"
                  MinWidth="120"
                  MinHeight="40"
                  Margin="6,2,4,2"
                  Click="OnHomeClick"
                  ToolTip="Return to the Home module map."/>
        </Grid>

        <!-- One-row header band: the brand title owns the star column and flexes into free
             space (trimming only under real pressure); the station chip and the truthfulness
             banners are Auto columns that never trim or wrap out of view. -->
        <Grid Grid.Column="1" Margin="8,3" MinWidth="0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="BrandLogoImage"
                 Width="20"
                 Height="20"
                 Stretch="Uniform"
                 Visibility="Collapsed"
                 VerticalAlignment="Center"
                 Margin="0,0,6,0"/>
          <Ellipse Grid.Column="1" x:Name="BrandAccentDot" Width="12" Height="12" VerticalAlignment="Center" Fill="#1EA7A1"/>
          <TextBlock Grid.Column="2"
                     x:Name="BrandTitleText"
                     Text="AOI MONITOR"
                     Foreground="{DynamicResource HmiTextBrush}"
                     FontSize="{StaticResource HmiFontSizeSection}"
                     FontWeight="ExtraBold"
                     VerticalAlignment="Center"
                     Margin="7,0,8,0"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
          <Border Grid.Column="3" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" Padding="7,3" Margin="0,0,4,0" MaxWidth="205" MinHeight="34" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Station " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StationNameText" Text="AOI-LIB" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="ExtraBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="130" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock x:Name="StationSubtitleText" Text="local review console / prototype" Visibility="Collapsed" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="4" x:Name="OperatingModeBanner" Style="{StaticResource HmiPersistentBanner}" Background="#2A1740" BorderBrush="#8F5FD1" VerticalAlignment="Center">
            <TextBlock x:Name="OperatingModeBannerText" Text="Demo Mode" Foreground="#F1D8FF" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="ExtraBold" TextWrapping="NoWrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
          </Border>
          <Border Grid.Column="5" x:Name="DeploymentProfileBanner" Style="{StaticResource HmiPersistentBanner}" Background="#172A39" BorderBrush="#5CA0D3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Profile " Foreground="#CFEAFF" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="DeploymentProfileBannerText" Text="Stage 1 Image" Foreground="#E7F5FF" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="6" x:Name="SimulationWarningBanner" Style="{StaticResource HmiPersistentBanner}" Background="#372914" BorderBrush="#E1A334" VerticalAlignment="Center">
            <TextBlock x:Name="SimulationWarningBannerText" Text="SIM / MOCK ACTIVE" Foreground="#FFE0A7" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="ExtraBold" TextWrapping="NoWrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
          </Border>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,3,12,3">
          <Border Style="{StaticResource HmiPersistentBanner}" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderMidBrush}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="User " Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="HeaderUserText" Text="Engineer01" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text=" / " Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="HeaderRoleText" Text="Admin" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="74" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HmiPersistentBanner}" Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderMidBrush}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Engine " Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="HeaderEngineText" Text="Pixel Diff Prototype" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="230" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </Border>
          <Button x:Name="ActiveAlarmsButton"
                  AutomationProperties.Name="Active alarms"
                  Style="{StaticResource MiniBtn}"
                  MinWidth="238"
                  MinHeight="34"
                  Padding="8,3"
                  Margin="{StaticResource HmiButtonGap}"
                  Click="OnActiveAlarmsButtonClick"
                  ToolTip="Open active alarm list.">
            <Grid MinWidth="210">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Alarms" Foreground="{DynamicResource HmiTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="ActiveAlarmHeaderText"
                         Grid.Column="1"
                         Text="none"
                         Foreground="{DynamicResource HmiTextBodyBrush}"
                         FontSize="{StaticResource HmiFontSizeBody}"
                         FontWeight="Bold"
                         HorizontalAlignment="Right"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="210"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Grid>
          </Button>
          <Popup x:Name="ActiveAlarmsPopup"
                 Placement="Bottom"
                 PlacementTarget="{Binding ElementName=ActiveAlarmsButton}"
                 HorizontalOffset="-260"
                 VerticalOffset="4"
                 AllowsTransparency="True"
                 StaysOpen="False"
                 Closed="OnActiveAlarmsPopupClosed">
            <Border Background="{DynamicResource HmiFlyoutBrush}" BorderBrush="{DynamicResource HmiFlyoutBorderBrush}" BorderThickness="1" Padding="10" Width="520" MaxHeight="430">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="170"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="ACTIVE ALARMS" Foreground="{DynamicResource HmiNgSoftBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
                  <Button Grid.Column="1" Style="{StaticResource MiniBtn}" MinWidth="86" Content="Close" Click="OnCloseActiveAlarmsClick"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="ActiveAlarmSummaryText" Text="No active alarms." Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                  <ComboBox x:Name="AlarmSeverityFilterCombo" Width="154" MinHeight="34" Margin="0,0,6,6" AutomationProperties.Name="Alarm severity filter" SelectionChanged="OnAlarmFilterChanged">
                    <ComboBoxItem Content="All severities" IsSelected="True"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Alarm"/>
                    <ComboBoxItem Content="Critical"/>
                  </ComboBox>
                  <ComboBox x:Name="AlarmSortCombo" Width="178" MinHeight="34" Margin="0,0,6,6" AutomationProperties.Name="Alarm sort order" SelectionChanged="OnAlarmFilterChanged">
                    <ComboBoxItem Content="Severity high first" IsSelected="True"/>
                    <ComboBoxItem Content="Newest first"/>
                    <ComboBoxItem Content="Oldest first"/>
                    <ComboBoxItem Content="Severity low first"/>
                  </ComboBox>
                  <TextBox x:Name="AlarmSourceFilterText" Width="150" MinHeight="34" Margin="0,0,0,6" AutomationProperties.Name="Alarm source filter" TextChanged="OnAlarmSourceFilterTextChanged" ToolTip="Filter by alarm source."/>
                </WrapPanel>
                <ListBox x:Name="AlarmListBox"
                         Grid.Row="3"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource HmiSurfaceBrush}"
                         BorderBrush="#384149"
                         Foreground="{DynamicResource HmiTextBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="4">
                        <TextBlock Text="{Binding Summary}" FontSize="{StaticResource HmiFontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActionSummary}" FontSize="{StaticResource HmiFontSizeBody}" Foreground="{DynamicResource HmiTextBodyBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
                  <Button x:Name="AcknowledgeAlarmBtn" Style="{StaticResource MiniBtnAmber}" Content="Acknowledge" Margin="0,0,6,0" Click="OnAcknowledgeAlarmClick"/>
                  <Button x:Name="AcknowledgeAllAlarmsBtn" Style="{StaticResource MiniBtnAmber}" Content="Acknowledge All" Margin="0,0,6,0" Click="OnAcknowledgeAllAlarmsClick" ToolTip="Acknowledge every active alarm in one action. Alarms stay listed until resolved."/>
                  <Button x:Name="AlarmDetailsBtn" Style="{StaticResource MiniBtn}" Content="Details" Margin="0,0,6,0" Click="OnAlarmDetailsClick"/>
                  <Button x:Name="ExportAlarmLogBtn" Style="{StaticResource MiniBtnGreen}" Content="Export Log" Click="OnExportAlarmLogClick"/>
                </WrapPanel>
              </Grid>
            </Border>
          </Popup>
          <Button x:Name="AccessPanelButton"
                  Style="{StaticResource MiniBtn}"
                  Content="Access"
                  MinWidth="92"
                  MinHeight="34"
                  Margin="0"
                  Click="OnAccessPanelButtonClick"
                  ToolTip="Open access, login, and local user controls."/>
          <Popup x:Name="AccessPanelPopup"
                 Placement="Bottom"
                 PlacementTarget="{Binding ElementName=AccessPanelButton}"
                 HorizontalOffset="-628"
                 VerticalOffset="4"
                 AllowsTransparency="True"
                 StaysOpen="False">
            <Border Background="{DynamicResource HmiFlyoutAltBrush}" BorderBrush="{DynamicResource HmiFlyoutBorderBrush}" BorderThickness="1" Padding="10" Width="720">
              <StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="FileMenuBtn" Style="{StaticResource MiniBtn}" Content="File" Margin="0,0,6,6" Click="OnMenuFileClick"/>
                  <Button x:Name="ReportIssueBtn" Style="{StaticResource MiniBtnAmber}" MinWidth="120" Content="Report Issue" Margin="0,0,6,6" Click="OnReportIssueClick"/>
                  <Button x:Name="LayoutStressBtn" Style="{StaticResource MiniBtn}" MinWidth="120" Content="Layout Stress" Margin="0,0,6,6" Click="OnLayoutStressClick"/>
                  <Button x:Name="SupportBundleBtn" Style="{StaticResource MiniBtn}" MinWidth="140" Content="Support Bundle" Margin="0,0,0,6" Click="OnExportSupportBundleClick"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                  <Border Width="220" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="User" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" x:Name="UserIdText" Text="Engineer01" Margin="6,0,0,0" AutomationProperties.Name="User ID"/>
                    </Grid>
                  </Border>
                  <Border Width="190" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Role" Foreground="{DynamicResource HmiWarnBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="RoleCombo" SelectedIndex="2" Margin="4,0,0,0" AutomationProperties.Name="User role" SelectionChanged="OnRoleSelectionChanged">
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="Engineer"/>
                        <ComboBoxItem Content="Admin"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Width="300" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Auth" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="AuthModeCombo" SelectedIndex="0" Margin="4,0,0,0" AutomationProperties.Name="Authentication mode" SelectionChanged="OnAuthModeSelectionChanged">
                        <ComboBoxItem Content="DemoLocalRoleSelector"/>
                        <ComboBoxItem Content="LocalUsers"/>
                        <ComboBoxItem Content="MesAuthenticationBoundary"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                </WrapPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="PW" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="{StaticResource HmiFontSizeBody}" VerticalAlignment="Center"/>
                  <PasswordBox Grid.Column="1" x:Name="LoginPasswordBox" MinHeight="34" Margin="4,0,8,0" AutomationProperties.Name="Login password"/>
                  <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Content="Login" Click="OnLocalLoginClick"/>
                </Grid>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                  <Button x:Name="CreateUserBtn" Style="{StaticResource MiniBtn}" Content="Add User" Margin="6,0,0,0" Click="OnCreateLocalUserClick"/>
                  <Button x:Name="ChangePasswordBtn" Style="{StaticResource MiniBtn}" Content="Set PW" Margin="6,0,0,0" Click="OnChangeLocalPasswordClick"/>
                  <Button x:Name="DisableUserBtn" Style="{StaticResource MiniBtn}" Content="Disable" Margin="6,0,0,0" Click="OnDisableLocalUserClick"/>
                  <Button x:Name="DeleteUserBtn" Style="{StaticResource MiniBtn}" Content="Delete" Margin="6,0,0,0" Click="OnDeleteLocalUserClick"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>

      <Grid x:Name="ShellHiddenStateHost" Visibility="Collapsed" IsHitTestVisible="False">
        <Border x:Name="StationBadgeBorder"/>
        <TextBlock x:Name="DatabaseStatusText" Text="Not Connected"/>
        <TextBlock x:Name="ImageVaultStatusText" Text="Not Available"/>
        <TextBlock x:Name="InspectionEngineStatusText" Text="Pixel Difference Prototype Engine"/>
        <TextBlock x:Name="CameraStatusText" Text="Not Connected"/>
        <TextBlock x:Name="LightingStatusText" Text="Not Connected"/>
        <TextBlock x:Name="RobotStatusText" Text="Not Connected"/>
        <TextBlock x:Name="MesStatusText" Text="Not Connected"/>
        <TextBlock x:Name="EmergencyStopStatusText" Text="Not Connected"/>
        <TextBlock x:Name="PageTitleText"/>
        <TextBlock x:Name="WorkflowSampleText" Text="none"/>
        <TextBlock x:Name="WorkflowGoldenText" Text="none"/>
        <TextBlock x:Name="WorkflowScoreText" Text="--"/>
        <Border x:Name="WorkflowVerdictBorder"/>
        <TextBlock x:Name="WorkflowVerdictText" Text="REVIEW"/>
        <Button x:Name="RefreshPageBtn" Click="OnRefreshClick"/>
        <Button x:Name="LockRecipeBtn" Click="OnLockRecipeClick"/>
        <Button x:Name="ExportBtn" Click="OnExportClick"/>
      </Grid>

      <Grid Grid.Row="1" Background="{DynamicResource Bg}">
            <ContentControl x:Name="PageContent"/>
            <Border x:Name="PageErrorCard"
                    Background="{DynamicResource HmiScrimBrush}"
                    BorderBrush="#9A393E"
                    BorderThickness="1"
                    Margin="18"
                    Padding="18"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="15">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Recoverable page error" Foreground="{DynamicResource HmiNgSoftBrush}" FontSize="{StaticResource HmiFontSizeSection}" FontWeight="Bold"/>
                  <ScrollViewer MaxHeight="128"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="0,8,0,0">
                    <TextBlock x:Name="PageErrorText" Text="The page failed to refresh." Foreground="{DynamicResource HmiTextBrush}" TextWrapping="Wrap"/>
                  </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                  <Button Style="{StaticResource MiniBtn}" Content="Retry" Margin="0,0,8,0" Click="OnRefreshClick"/>
                  <Button Style="{StaticResource MiniBtn}" Content="Dismiss" Click="OnDismissPageErrorClick"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="LoadingOverlay" Background="{DynamicResource HmiLoadingScrimBrush}" Visibility="Collapsed" Panel.ZIndex="20">
              <Border Background="{DynamicResource HmiSurfaceBrush}" BorderBrush="#5A646D" BorderThickness="1" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260">
                <StackPanel>
                  <TextBlock x:Name="LoadingOverlayText" Text="Loading..." Foreground="{DynamicResource HmiTextBrush}" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextAlignment="Center"/>
                  <ProgressBar IsIndeterminate="True" Height="8" Margin="0,12,0,0"/>
                  <Button x:Name="CancelPageLoadBtn" Style="{StaticResource MiniBtn}" Content="Cancel" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnCancelPageLoadClick"/>
                </StackPanel>
              </Border>
            </Border>
      </Grid>

      <Grid Grid.Row="2" Background="{DynamicResource HmiChromeAltBrush}" MinHeight="34">
        <Border BorderBrush="#2E3D47" BorderThickness="0,1,0,0">
          <DockPanel Margin="10,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MaxWidth="560">
              <TextBlock Text="Station " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="FooterStationText" Text="AOI-LIB-01" FontWeight="Bold" Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="Link " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="FooterIndexText" Text="SQLite" FontWeight="Bold" Foreground="{DynamicResource HmiOkBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="DB Updated " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="FooterDbUpdatedText" Text="--" FontWeight="Bold" Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="120" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" MaxWidth="560">
              <TextBlock Text="REC " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="FooterRecordCountText" Text="0" FontWeight="Bold" Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="70" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="DB REV " Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}"/>
              <TextBlock x:Name="FooterDbRevText" Text="local" FontWeight="Bold" Foreground="{DynamicResource HmiTextBodyBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="110" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
